# Stage 2 of the network + search test (tuning, internal go/no-go; pre-registration .orchestra/fastenv/NETSEARCH-PREREG.md):
# 3 margins from Stage 1 (the design's 3.1 rule on the pooled R curve re-scored with G9p@100M) vs our pure gen9 search.
NAME=stage2
GEN=9
TAG=20261110
NET=$C/nets/g9p-100M.pt
OPP='search:none,ms=1000,samples=4,eval_config=stock,prior_weight=0,workers=11'
ARMS=("netsearch:$NET,margin=@D1@,temperature=0.5,ms=1000,samples=4,workers=11"
      "netsearch:$NET,margin=@D2@,temperature=0.5,ms=1000,samples=4,workers=11"
      "netsearch:$NET,margin=@D3@,temperature=0.5,ms=1000,samples=4,workers=11")
BLOCK_PAIRS=50
BLOCKS=4
CONC=3
FUTILITY=0.5
MIN_CPUS=24
BLOCK_TIMEOUT_MIN=150
