# Smoke test of the slot harness (helper job, 8 CPUs; NOT the benchmark slot): 2 arms x 1 block x 1 pair = 4 games.
# Arm 1 searches and gates (margin 0.02), arm 2 is the raw net through the hybrid's code path (margin inf).
NAME=smoke
GEN=9
TAG=smoke20261109
NET=$C/nets/g9p-67.5M.pt
OPP='search:none,ms=1000,samples=4,eval_config=stock,prior_weight=0,workers=3'
ARMS=("netsearch:$NET,margin=0.02,temperature=0.5,ms=1000,samples=4,workers=3"
      "netsearch:$NET,margin=inf,temperature=0.5,ms=1000,samples=4,workers=3")
BLOCK_PAIRS=1
BLOCKS=1
CONC=1
FUTILITY=0.5
MIN_CPUS=8
BLOCK_TIMEOUT_MIN=30
