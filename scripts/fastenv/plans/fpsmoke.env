# Harness smoke of the Foul Play mode (OPP=foulplay; Stage 3b's harness, NOT a 3b run): an old net, a smoke seed tag,
# 2 Foul Play instances, 2 pairs per arm; checks the instances start, the shared engine pool, budget, logs and report.
NAME=fpsmoke
GEN=9
TAG=fpsmoke20261110
NET=$C/nets/g9p-67.5M.pt
NETV2_DIR=$C/frozen/netv2-fba02fb-20261110
OPP='foulplay:ms=1000,parallelism=1'
ARMS=("netsearch:$NET,margin=0.0212,temperature=0.5,ms=1000,samples=4,workers=3"
      'search:none,ms=1000,samples=4,eval_config=stock,prior_weight=0,workers=3')
BLOCK_PAIRS=2
BLOCKS=1
CONC=2
FUTILITY=
MIN_CPUS=8
BLOCK_TIMEOUT_MIN=40
