OPP='search:none,ms=1000,samples=4,eval_config=stock,prior_weight=0,workers=11'
ARMS=('netsearch:net.pt,margin=0.02,ms=1000,samples=4,workers=11'
      'netsearch:net.pt,margin=0.03,ms=1000,samples=4,workers=11'
      'netsearch:net.pt,margin=0.04,ms=1000,samples=4,workers=11')
DRY_P=(0.2 0.55 0.56)
BLOCK_PAIRS=50
BLOCKS=4
CONC=3
FUTILITY=0.5
MIN_CPUS=24
