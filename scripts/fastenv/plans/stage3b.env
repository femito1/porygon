# Stage 3b of the network + search test (headline, FIXED n; pre-registered in .orchestra/fastenv/NETSEARCH-PREREG.md,
# harness details in NETSEARCH-3B-HARNESS.md): H(delta*) and our pure gen9 search, each vs Foul Play gen9 (1000 ms,
# search-parallelism 1, as the gen9 Foul Play benchmark), on Stage 3a's 500 test team pairs (tag 20261111).
# Runs only if 3a succeeds (Q1) and the orchestrator approves. Q2: netsearch_slot.py paired RUN 1 2.
NAME=stage3b
GEN=9
TAG=20261111
NET=$C/nets/g9p-cd-104.71M.pt   # the gate-passing snapshot (sha256 = its gate manifest)
NETV2_DIR=$C/frozen/netv2-fba02fb-20261110   # netv2's src/porygon as frozen at registration
OPP='foulplay:ms=1000,parallelism=1'
ARMS=("netsearch:$NET,margin=0.0212,temperature=0.5,ms=1000,samples=4,workers=11"
      'search:none,ms=1000,samples=4,eval_config=stock,prior_weight=0,workers=11')
BLOCK_PAIRS=100
BLOCKS=5
CONC=3
FUTILITY=
MIN_CPUS=24
BLOCK_TIMEOUT_MIN=240
