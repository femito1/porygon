# Stage 3a + 3c of the network + search test (headline, FIXED n; pre-registered in .orchestra/fastenv/NETSEARCH-PREREG.md
# before Stage 2's first game). Arm 1 = H(delta*) from Stage 2, arm 2 = the raw snapshot at T 0.5; both vs our pure
# gen9 search on the same 500 test team pairs (tag 20261111). Only @DSTAR@ is filled in, from Stage 2's selection.
NAME=stage3ac
GEN=9
TAG=20261111
NET=$C/nets/g9p-100M.pt
OPP='search:none,ms=1000,samples=4,eval_config=stock,prior_weight=0,workers=11'
ARMS=("netsearch:$NET,margin=@DSTAR@,temperature=0.5,ms=1000,samples=4,workers=11"
      "$NET,temperature=0.5")
BLOCK_PAIRS=100
BLOCKS=5
CONC=3
FUTILITY=
MIN_CPUS=24
BLOCK_TIMEOUT_MIN=240
