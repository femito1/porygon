# 08:02 (pre-registered, STATUS.md; speed only): opponent-net GPU cache sized per GPU at the call sites below:
# --snapshot-cache 40 on the A30 (r1 branch), 16 on the A16 (g9 branch); the default 8 thrashed at 9 pool nets
# 10:25 (speed only): 96 on the A30 / 32 on the A16 -- the pools pass 40 / 16 nets at ~95M / ~35M steps (today ~17:00)
# 08:25 (pre-registered, STATUS.md; speed only): --stacked-opp on the A30 call sites only (A16 GPU memory too tight)
# 2026-11-09 16:08 (speed only; orchestrator brief 15:55): --snapshot-cache 32 -> 72 at the A16 G9s call site (g9 branch,
# MODE g9s) only: pool 25 + 2 frozen at 16:07, +1 per ~85 min => ~66 + 2 at the 11-12 01:44 deadline stop; A16 11.4 /
# 15.4 GB at 16:07, <= 24 MiB per net => <= +1.1 GB. The dormant G9p-on-A16 call site keeps 32.
# 2026-11-09 17:5x (speed only; orchestrator brief 17:25): G9p (r1 branch, MODE g9p) 96 -> 192 on the A30: pool 25 + 2
# frozen at 17:27, +1 per ~19.5 min => ~184 + 2 at the 11-11 21:31 deadline stop; 23.5 MiB per net (22.2 params + 1.3
# buffers, measured) => <= +3.9 GiB over the 27 nets cached at 17:27 (A30 15,983 / 24,576 MiB, an eval running);
# 640 on a >= 40 GB GPU (successor 810366 on an a40 / a100). G9s (g9 branch, MODE g9s): the A16 keeps 72 (headroom);
# on a >= 40 GB GPU (successor 810367 on an a40 / a100) 512 + --stacked-opp (the A30 call sites' 08:25 setting).
# v12 (2026-11-12, orchestrator-APPROVED design; incident 11-12 06:15: G9q's trainer on hopper died with RC 1 on a full
# node-wide /tmp tmpfs (ENOSPC in a tensorboard write) and, with chain_left 0, nothing ran for 5 h): the SUCCESSOR
# WATCHDOG, once per job at the job script's FIRST source of this file ($LOCAL/.nv2-watchdog), for runs r1 / g9 /
# g4r1bf, only in jobs with an id >= NV2_WD_MIN_JOB (1135476 = r1's pending successor; the jobs running at v12 --
# 1135184 r1, 810367 g9, 829660 g4r1bf, data's 810087 -- are also excluded by id: they never run it, not even at a
# restart in place). Kill switch: runs/WATCHDOG_OFF (or NV2_WD_OFF). Every action is logged to runs/RUN/WATCHDOG.log
# (NFS) and the job's train.log. In order:
#  (a) deliberate stops are never undone: runs/RUN/HOLD, runs/RUN/PARKED or runs/RUN/CHAIN_STOPPED exists, an inline
#      step was cut off (runs/RUN/INLINE_CMD.running), a park / swap INLINE_CMD is queued (runs/RUN/INLINE_CMD naming
#      swap-50M / -parked / PARKED), or (r1, g9) the 50M swap is undecided (runs/swap-50M without DECISION but with a
#      STATE line, a FAIL-* or a DONE handover; a decided swap is not in progress: its per-run apply is atomic in
#      nv2_swap) -> the job exits 0 at once: no training, no successor, no chain.
#      One trainer per run: if another job of this name is RUNNING and started earlier (same second: lower id), this
#      one exits 0 too, after queueing that job's successor if none is pending.
#  (b) runs/RUN/JOBSTARTS += "JOBID EPOCH NODE".
#  (c) /tmp guard: < NV2_TMP_MIN_GB (20) GB available on $LOCAL's filesystem -> resubmit this run with --exclude=<this
#      node>[,SLURM_JOB_EXC_NODES] (a PENDING job of this name instead gets the node added to its ExcNodeList) and exit 1
#      before training (the job script's CUDA-check pattern; no successor is queued, so only one job follows).
#  (d) crash-loop cap: the previous two jobs of this run each lived < 30 min (start-to-next-start in JOBSTARTS) ->
#      runs/RUN/CHAIN_STOPPED (reason), no successor, keep training (with (c): no resubmit, exit 1).
#  (e) else, if no job of this name is PENDING: sbatch this job's partition / gpu:1 / CPUs / mem / 72 h / name with
#      --dependency=afterany:<this job> (job id parsed from "Submitted batch job N" anywhere in the output).
#  (f) runs/RUN/chain_left -> 0 (the successor replaces the end-of-job chain: never two followers).
#  (g) a /tmp watcher (every NV2_TMPWATCH_POLL_S = 300 s; 0 = off, the mocks): < 8 GB -> a train.log warning (hourly);
#      < 3 GB -> mirror run + pool to the job dir now, add this node to the pending successor's ExcNodeList (none
#      pending: queue one excluding it, unless CHAIN_STOPPED), runs/RUN/TMP_ALERT, remove runs/RUN/restart, SIGINT the
#      trainer (the deadline watcher's PAT and method): it saves, the restart loop ends, the job mirrors and exits.
# A deliberate stop of a run: touch runs/RUN/CHAIN_STOPPED (or HOLD) BEFORE scancel (the afterany successor then exits
# at once), or scancel the pending successor too.
NV2_WD_MIN_JOB=${NV2_WD_MIN_JOB:-1135476}
nv2_wd_active() {
  [ -n "${LOCAL:-}" ] && [ -n "${NV2:-}" ] || return 1
  case ${RUN_NAME:-} in r1|g9|g4r1bf) ;; *) return 1 ;; esac
  case ${SLURM_JOB_ID:-} in ""|*[!0-9]*|1135184|810367|829660|810087) return 1 ;; esac
  [ "$SLURM_JOB_ID" -ge "$NV2_WD_MIN_JOB" ] || return 1
  [ -z "${NV2_WD_OFF:-}" ] && [ ! -e "$NV2/runs/WATCHDOG_OFF" ]
}
nv2_wd_log() {
  echo "$(date -u +%FT%T) ${SLURM_JOB_ID:-} $(hostname -s 2> /dev/null || echo '?') $*" >> "$NV2/runs/$RUN_NAME/WATCHDOG.log" 2> /dev/null || true
  echo "$(date -u +%T) watchdog: $*" >> "$LOCAL/run/train.log" 2> /dev/null || true
  echo "$(date -u +%T) watchdog: $*" >&2 || true
}
nv2_wd_jobs() {  # our jobs of this job's name, "ID STATE START DEPENDENCY" per line; returns 1 if squeue failed 3 times
  local k out
  for k in 1 2 3; do
    if out=$(squeue -h -u "${USER:-$(id -un)}" -n "$SLURM_JOB_NAME" -o '%i %T %S %E' 2> /dev/null); then printf '%s\n' "$out"; return 0; fi
    sleep "${NV2_WD_RETRY_S:-5}" || true
  done
  return 1
}
nv2_wd_sbatch() {  # nv2_wd_sbatch "OPTS" JOBARGS...: submit this run again with this job's resources; prints the job id ("" = failed)
  local o=$1 out; shift
  # shellcheck disable=SC2086
  out=$(cd "$NV2" && sbatch --job-name="$SLURM_JOB_NAME" --partition="${SLURM_JOB_PARTITION:-a30}" --gres=gpu:1 --cpus-per-task="${SLURM_CPUS_ON_NODE:-30}" --mem="${SLURM_MEM_PER_NODE:-98304}M" --time=72:00:00 $o scripts/slurm_train_v2.sbatch "$RUN_NAME" "$@" 2>&1) || true
  printf '%s\n' "$out" | grep -oE 'Submitted batch job [0-9]+' | tail -n 1 | grep -oE '[0-9]+$' || true
}
nv2_wd_exclude() {  # nv2_wd_exclude JOB NODE: add NODE to a pending job's ExcNodeList
  local cur new
  cur=$(scontrol show job "$1" 2> /dev/null | grep -oE 'ExcNodeList=[^ ]+' | head -n 1 | cut -d= -f2 || true)
  case ",$cur," in ",,"|",(null),") new=$2 ;; *",$2,"*) new=$cur ;; *) new=$cur,$2 ;; esac
  if scontrol update jobid="$1" ExcNodeList="$new" 2> /dev/null; then nv2_wd_log "pending $1: ExcNodeList=$new"; else nv2_wd_log "pending $1: scontrol update ExcNodeList=$new FAILED"; fi
}
nv2_wd_avail_kb() { df -Pk "$LOCAL" 2> /dev/null | awk 'NR == 2 && $4 ~ /^[0-9]+$/ {print $4}' || true; }
nv2_wd_stop() {  # nv2_wd_stop REASON: runs/RUN/CHAIN_STOPPED
  { echo "$(date -u +%FT%T) job ${SLURM_JOB_ID:-} on $(hostname -s 2> /dev/null || echo '?'): $1"
    echo "No successor was queued. A job of run $RUN_NAME that starts while this file exists exits at once (no training,"
    echo "no chaining). Fix the cause, remove this file, and queue a successor by hand if the run should go on."
    echo "JOBSTARTS (last 3):"; tail -n 3 "$NV2/runs/$RUN_NAME/JOBSTARTS" 2> /dev/null || true; } > "$NV2/runs/$RUN_NAME/CHAIN_STOPPED" 2> /dev/null || true
  nv2_wd_log "CHAIN_STOPPED: $1"
}
nv2_wd_rmlocal() {  # an exit before training: drop this job's (empty) node-local dir
  if [ -z "$(find "$LOCAL" -type f ! -name .nv2-watchdog ! -name train.log ! -name '.toucher-*' 2> /dev/null | head -n 1)" ]; then rm -rf "$LOCAL" || true; fi
}
nv2_wd_blocked() {  # prints why a job of this run must not start ("" = it may)
  local d=$NV2/runs/$RUN_NAME f
  for f in HOLD PARKED CHAIN_STOPPED; do if [ -e "$d/$f" ]; then echo "runs/$RUN_NAME/$f exists"; return 0; fi; done
  if [ -e "$d/INLINE_CMD.running" ]; then echo "runs/$RUN_NAME/INLINE_CMD.running exists (an inline step, e.g. a park or swap, was cut off)"; return 0; fi
  if [ -f "$d/INLINE_CMD" ] && grep -qE 'swap-50M|-parked|PARKED' "$d/INLINE_CMD" 2> /dev/null; then echo "a park / swap INLINE_CMD is queued (runs/$RUN_NAME/INLINE_CMD)"; return 0; fi
  case $RUN_NAME in r1|g9)
    if [ -d "$NV2_SWAP" ] && [ ! -f "$NV2_SWAP/DECISION" ] && { [ -s "$NV2_SWAP/STATE" ] || ls "$NV2_SWAP"/FAIL-* > /dev/null 2>&1 || [ -f "$NV2/runs/g9q/handover-a30/DONE" ] || [ -f "$NV2/runs/r1/handover-g9p-a16/DONE" ]; }; then
      echo "the 50M swap is in progress (runs/swap-50M has phase-1 state but no DECISION)"; return 0
    fi ;;
  esac
  return 0
}
nv2_wd_tmpwatch() {  # background /tmp watcher (see the v12 note)
  local bpid=$$ poll=${NV2_TMPWATCH_POLL_S:-300}
  [ "$poll" != 0 ] || return 0
  ( set +e
    pat=${NV2_DEADLINE_PAT:-"^${PY:-/vol/bitbucket/fr1226/gloria/.venv/bin/python} -u -m porygon.v2.train( |\$)"}; n=0; sent=" "
    warn=$(( ${NV2_TMP_WARN_GB:-8} * 1048576 )); low=$(( ${NV2_TMP_STOP_GB:-3} * 1048576 ))
    while kill -0 "$bpid" 2> /dev/null; do
      sleep "$poll"; kb=$(nv2_wd_avail_kb); [ -n "$kb" ] || continue
      if [ "$kb" -lt "$low" ]; then
        node=$(hostname -s 2> /dev/null || echo '?')
        nv2_wd_log "/tmp has $((kb / 1024)) MB left (< ${NV2_TMP_STOP_GB:-3} GB) on $node: mirror, exclude $node from the successor, stop the trainer"
        touch "$LOCAL/TMP_LOW" 2> /dev/null
        jd=$(ls -td "$NV2/runs/$RUN_NAME"/*-"$SLURM_JOB_ID" 2> /dev/null | head -n 1)
        if [ -n "$jd" ] && rsync -a "$LOCAL/run/" "$jd/" && rsync -a --exclude .tmp --exclude '*.tmp' "$LOCAL/pool/" "$NV2/runs/$RUN_NAME/pool/"; then nv2_wd_log "mirror to $jd done"; else nv2_wd_log "mirror to ${jd:-?} FAILED (the job's own mirrors still run)"; fi
        p=$(nv2_wd_jobs | awk -v me="$SLURM_JOB_ID" '$1 != me && $2 == "PENDING" {print $1}')
        if [ -n "$p" ]; then for j in $p; do nv2_wd_exclude "$j" "$node"; done
        elif [ ! -e "$NV2/runs/$RUN_NAME/CHAIN_STOPPED" ]; then j=$(nv2_wd_sbatch "--exclude=$node --dependency=afterany:$SLURM_JOB_ID" "$@"); nv2_wd_log "no successor was pending: queued ${j:-NOTHING (sbatch failed)} excluding $node"; fi
        echo "$(date -u +%FT%T) job $SLURM_JOB_ID on $node: /tmp $((kb / 1024)) MB left; trainer stopped (save + mirror), successor excludes $node" > "$NV2/runs/$RUN_NAME/TMP_ALERT"
        rm -f "$NV2/runs/$RUN_NAME/restart"
        nv2_wd_log "restart flag removed, stopping the trainer"
        while kill -0 "$bpid" 2> /dev/null; do
          for q in $(pgrep -P "$bpid" -f "$pat"); do
            case $sent in *" $q "*) continue ;; esac
            if kill -INT "$q"; then sent="$sent$q "; nv2_wd_log "SIGINT $q"; fi
          done
          sleep 10
        done
        exit 0
      elif [ "$kb" -lt "$warn" ]; then
        if [ $((n % 12)) = 0 ]; then nv2_wd_log "WARNING: /tmp has $((kb / 1024)) MB left (< ${NV2_TMP_WARN_GB:-8} GB)"; fi
        n=$((n + 1))
      fi
    done ) > /dev/null 2>&1 < /dev/null &
  return 0
}
nv2_watchdog() {  # nv2_watchdog JOBARGS... (see the v12 note)
  local d node why id st start dep me="" mine="" first="" pend="" e1="" e2="" e3="" kb loop="" x jobs
  nv2_wd_active || return 0
  [ ! -e "$LOCAL/.nv2-watchdog" ] || return 0
  touch "$LOCAL/.nv2-watchdog" 2> /dev/null || true
  d=$NV2/runs/$RUN_NAME; mkdir -p "$d" || true; node=$(hostname -s 2> /dev/null || echo unknown)
  why=$(nv2_wd_blocked)
  if [ -n "$why" ]; then nv2_wd_log "exit without training or chaining: $why"; nv2_wd_rmlocal; exit 0; fi
  if jobs=$(nv2_wd_jobs); then
    mine=$(printf '%s\n' "$jobs" | awk -v me="$SLURM_JOB_ID" '$1 == me {print $3}'); mine=${mine:-$(date +%FT%T)}
    while read -r id st start dep; do
      [ -n "$id" ] && [ "$id" != "$SLURM_JOB_ID" ] && [ "$st" = RUNNING ] || continue
      if [[ "$start" < "$mine" ]] || { [ "$start" = "$mine" ] && [ "$id" -lt "$SLURM_JOB_ID" ]; }; then first=$id; break; fi
    done <<< "$jobs"
    pend=$(printf '%s\n' "$jobs" | awk -v me="$SLURM_JOB_ID" '$1 != me && $2 == "PENDING" {print $1}' | tr '\n' ' ')
    if [ -n "$first" ]; then
      if [ -z "$pend" ] && [ ! -e "$d/CHAIN_STOPPED" ]; then x=$(nv2_wd_sbatch "--dependency=afterany:$first" "$@"); nv2_wd_log "job $first of this run is already running: queued its successor ${x:-NOTHING (sbatch failed)}"; fi
      nv2_wd_log "exit without training or chaining: job $first of run $RUN_NAME is already running (started $start)${pend:+; pending: $pend}"
      nv2_wd_rmlocal; exit 0
    fi
  else jobs=""; pend="?"; nv2_wd_log "squeue failed 3 times: no duplicate check, no successor queued"; fi
  echo "$SLURM_JOB_ID $(date +%s) $node" >> "$d/JOBSTARTS" 2> /dev/null || true
  read -r e1 e2 e3 <<< "$(tail -n 3 "$d/JOBSTARTS" 2> /dev/null | awk '{print $2}' | tr '\n' ' ')" || true
  case "$e1$e2$e3" in ""|*[!0-9]*) ;; *)
    if [ -n "$e3" ] && [ $((e3 - e2)) -lt "${NV2_WD_SHORT_S:-1800}" ] && [ $((e2 - e1)) -lt "${NV2_WD_SHORT_S:-1800}" ]; then loop="the previous two jobs each lived < $(( ${NV2_WD_SHORT_S:-1800} / 60 )) min ($((e2 - e1)) s, $((e3 - e2)) s)"; fi ;;
  esac
  x=$(cat "$d/chain_left" 2> /dev/null || true)
  if [ "$x" != 0 ]; then echo 0 > "$d/chain_left" 2> /dev/null || true; nv2_wd_log "chain_left ${x:-unset} -> 0 (the successor watchdog replaces the end-of-job chain)"; fi
  kb=$(nv2_wd_avail_kb)
  nv2_wd_log "first start on $node: /tmp ${kb:-?} KB available; MODE ${RUN_NAME}: $(cat "$d/MODE" 2> /dev/null || echo -)"
  if [ -n "$kb" ] && [ "$kb" -lt $(( ${NV2_TMP_MIN_GB:-20} * 1048576 )) ]; then
    if [ -n "$loop" ]; then nv2_wd_stop "/tmp has $((kb / 1048576)) GB < ${NV2_TMP_MIN_GB:-20} GB on $node and $loop: no resubmit"; nv2_wd_rmlocal; exit 1; fi
    x=$node${SLURM_JOB_EXC_NODES:+,$SLURM_JOB_EXC_NODES}
    if [ -n "$pend" ] && [ "$pend" != "?" ]; then for id in $pend; do nv2_wd_exclude "$id" "$node"; done; nv2_wd_log "/tmp has $((kb / 1048576)) GB < ${NV2_TMP_MIN_GB:-20} GB: job $pend already pending (excludes $node now); exit before training"
    else id=$(nv2_wd_sbatch "--exclude=$x" "$@"); nv2_wd_log "/tmp has $((kb / 1048576)) GB < ${NV2_TMP_MIN_GB:-20} GB: resubmitted as ${id:-NOTHING (sbatch failed)} excluding $x; exit before training (MODE stays $(cat "$d/MODE" 2> /dev/null || echo -))"; fi
    echo "$(date -u +%FT%T) job $SLURM_JOB_ID on $node: /tmp $((kb / 1048576)) GB at the start: resubmitted excluding $x" > "$d/TMP_ALERT" 2> /dev/null || true
    nv2_wd_rmlocal; exit 1
  fi
  if [ -n "$loop" ]; then nv2_wd_stop "$loop: crash loop; this job keeps training"
  elif [ "$pend" = "?" ]; then nv2_wd_log "no successor queued (squeue failed): queue one by hand"
  elif [ -n "$pend" ]; then nv2_wd_log "successor already pending: $pend"
  else x=$(nv2_wd_sbatch "--dependency=afterany:$SLURM_JOB_ID" "$@"); nv2_wd_log "queued successor ${x:-NOTHING (sbatch failed)} (afterany:$SLURM_JOB_ID)"; fi
  nv2_wd_tmpwatch "$@"
  return 0
}
nv2_watchdog "$@"
nv2_deadline_watch
case $RUN_NAME in
  smoke*) TRAIN_ARGS="--max-hours 0.6 --eval-every 2000000 --eval-battles 60 --checkpoint-every 2000000 --snapshot-every 1000000"
          ANCHOR=$V1_46M ;;
  r1*)    PREEMPT_NAMES="ws-netv2-r1long"
          if [ "${SLURM_JOB_NAME:-}" = ws-netv2-r1long ]; then YIELD_TO=ws-netv2-r1; N_SELFPLAY=32; N_POOL=16; fi  # vm-kn-a16: ~26 GB free
          nv2_pool_trip r1
          if [ "$(cat "$NV2/runs/r1/MODE" 2>/dev/null || true)" = g9s ]; then nv2_second_trip r1 G9s g9s; fi
          if [ "$(cat "$NV2/runs/r1/MODE" 2>/dev/null || true)" = g9p ]; then nv2_second_trip r1 G9p g9a30; fi
          if [ "$(cat "$NV2/runs/r1/MODE" 2>/dev/null || true)" = g9q ]; then nv2_second_trip r1 G9q g9q; fi
          if [ "$(cat "$NV2/runs/r1/MODE" 2>/dev/null || true)" = g9t ]; then nv2_second_trip r1 G9t g9t; fi
          nv2_pause r1
          nv2_swap r1
          R1_MODE=$(cat "$NV2/runs/r1/MODE" 2>/dev/null || echo r1b)
          G9_RES=$(head -n 1 "$NV2/runs/r1/G9_RESUME" 2>/dev/null || true)
          # v9 swap (nv2_swap above): MODE g9q = this A30 trains the G9q lineage (G9p's recipe with P3: BC net P3, guard
          # state runs/g9q, eval anchor P1, November sets for the collector) from 741849's handover runs/g9q/handover-a30/
          # in the lineage dir $LOCAL/run/G9q (no G9q dir on dipper: never a stale one) with the A30 call-site settings
          # (28 workers, cache 192 / 640 on >= 40 GB + --stacked-opp, successors through the wrapper + --snapshot-cache-cpu
          # 400; actor stream as for G9p unless runs/g9q/NO_ACTOR_STREAM exists). First start (runs/r1/G9Q_A30_STARTED
          # absent) only from a DONE handover under DECISION COMMIT, else G9p continues here (its own local save).
          G9Q_A30=$NV2/runs/g9q/handover-a30
          if [ "$R1_MODE" = g9t ] && ! nv2_g9t_recipe r1 G9q; then R1_MODE=g9q; fi  # v12 draft: refused -> G9q continues
          if [ "$R1_MODE" = g9q ] && [ ! -f "$NV2/runs/r1/G9Q_A30_STARTED" ] && ! nv2_swap_ready "$G9Q_A30"; then
            if [ -n "${LOCAL:-}" ]; then echo "$(date -u +%T) MODE g9q but no committed G9q handover in $G9Q_A30 (DECISION: $(nv2_swap_decision)): G9p continues" >> "$LOCAL/run/train.log" || true; fi
            R1_MODE=g9p
          fi
          if [ "$R1_MODE" = g9q ] || [ "$R1_MODE" = g9t ]; then export PORYGON_PS=/vol/bitbucket/fr1226/porygon-ws-fastenv/ps-2026-11; else unset PORYGON_PS; fi
          # MAIN-RUN RULE swap (STATUS.md, agent 4): MODE g9p = this A30 trains the G9p lineage (P1-init G9) from
          # 741849's handover runs/g9/handover-g9p-a30/ in its own lineage dir $LOCAL/run/G9p (28 workers, guard state
          # runs/g9a30 as before); no handover (yet) -> G9s continues here, so the swap never forks or idles a lineage
          G9P_A30=$NV2/runs/g9/handover-g9p-a30
          if [ "$R1_MODE" = g9p ] && [ ! -f "$NV2/runs/r1/G9P_A30_STARTED" ] && [ ! -f "$G9P_A30/final_model.pt" ]; then
            if [ -n "${LOCAL:-}" ]; then echo "$(date -u +%T) MODE g9p but no G9p handover in $G9P_A30: G9s continues" >> "$LOCAL/run/train.log" || true; fi
            R1_MODE=g9s
          fi
          if [ "$R1_MODE" = g9q ]; then
            mkdir -p "$NV2/runs/g9q" || true
            G9QA_FIRST=""
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/r1/G9Q_A30_STARTED" ]; then
              G9QA_FIRST=1
              mkdir -p "$LOCAL/run/G9q" || true
              if [ ! -d "$LOCAL/run/G9q/pool" ]; then cp -rp "$G9Q_A30/pool" "$LOCAL/run/G9q/pool" || mkdir -p "$LOCAL/run/G9q/pool" || true; fi
              for f in best_model.pt ema_model.pt GUARD_TRIPPED; do if [ -f "$G9Q_A30/$f" ]; then cp -p "$G9Q_A30/$f" "$LOCAL/run/G9q/$f" || true; fi; done
              date -u +%FT%T > "$NV2/runs/r1/G9Q_A30_STARTED" || true
              echo "$(date -u +%T) G9q first start on this A30 from $G9Q_A30 (pool + best / ema copied); November sets (PORYGON_PS=$PORYGON_PS)" >> "$LOCAL/run/train.log" || true
            fi
            nv2_lineage_dirs G9q ""
            if [ -n "$G9QA_FIRST" ]; then NV2_LIN_RESUME=$G9Q_A30/final_model.pt; fi  # first start: the handover state
            NV2_G9QA_CACHE=192; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9QA_CACHE=640; fi
            NV2_G9QA_CPU=""; if nv2_successor; then PY=$NV2_SUCC_PY; NV2_G9QA_CPU=" --snapshot-cache-cpu 400"; elif nv2_newsrc_718701; then PY=$NV2_SUCC_PY; fi
            nv2_cfg_g9 28 g9q "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS --snapshot-cache $NV2_G9QA_CACHE --stacked-opp$NV2_G9QA_CPU" "$G9_P3"
            if [ ! -f "$NV2/runs/g9q/NO_ACTOR_STREAM" ]; then nv2_actor_stream_g9p; fi
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9Q_A30/final_model.pt}" ;; esac
          elif [ "$R1_MODE" = g9t ]; then
            # v12 draft: G9t on the A30 (see the v12 note above nv2_g9t_parse): G9q's A30 successor settings
            NV2_G9T_OPP="--snapshot-cache 192 --stacked-opp"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9T_OPP="--snapshot-cache 640 --stacked-opp"; fi
            nv2_cfg_g9t r1 28 "$NV2_G9T_OPP --snapshot-cache-cpu 400"
          elif [ "$R1_MODE" = g9p ]; then
            G9P_FIRST=""
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/r1/G9P_A30_STARTED" ]; then
              G9P_FIRST=1
              mkdir -p "$LOCAL/run/G9p" || true
              if [ ! -d "$LOCAL/run/G9p/pool" ]; then cp -rp "$G9P_A30/pool" "$LOCAL/run/G9p/pool" || mkdir -p "$LOCAL/run/G9p/pool" || true; fi
              for f in best_model.pt ema_model.pt GUARD_TRIPPED; do if [ -f "$G9P_A30/$f" ]; then cp -p "$G9P_A30/$f" "$LOCAL/run/G9p/$f" || true; fi; done
              date -u +%FT%T > "$NV2/runs/r1/G9P_A30_STARTED" || true
            fi
            nv2_lineage_dirs G9p ""
            if [ -n "$G9P_FIRST" ]; then NV2_LIN_RESUME=$G9P_A30/final_model.pt; fi  # first start: the handover state
            NV2_G9P_CACHE=192; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9P_CACHE=640; fi
            NV2_G9P_CPU=""; if nv2_successor; then PY=$NV2_SUCC_PY; NV2_G9P_CPU=" --snapshot-cache-cpu 400"; elif nv2_newsrc_718701; then PY=$NV2_SUCC_PY; fi
            nv2_cfg_g9 28 g9a30 "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS --snapshot-cache $NV2_G9P_CACHE --stacked-opp$NV2_G9P_CPU"
            nv2_actor_stream_g9p
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9P_A30/final_model.pt}" ;; esac
          elif [ "$R1_MODE" = g9s ]; then
            # G9s (04:58, STATUS.md): the gen9 main run from scratch in its own lineage dir $LOCAL/run/G9s; first start
            # from runs/g9s/init-g9s.pt (a fresh Net with P1's cfg), then its own final_model.pt (restart in place) or,
            # after a requeue, its newest mirrored file. (The G9 lineage = G9p moved to 741849 at the same switch.)
            nv2_lineage_dirs G9s ""
            nv2_cfg_g9s 28 "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS --snapshot-cache 96 --stacked-opp"
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$NV2/runs/g9s/init-g9s.pt}" ;; esac
          elif [ "$R1_MODE" = g9 ] && { [ -f "$NV2/runs/r1/G9_STARTED" ] || { [ -n "$G9_RES" ] && [ -f "$G9_RES" ]; }; }; then
            # this (A30) allocation trains the G9 lineage: first relaunch from runs/r1/G9_RESUME, later restarts
            # continue from final_model.pt; pool in $LOCAL/run/pool9 (mirrored with the run dir), 28 fastenv workers
            G9_FIRST=""
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/r1/G9_STARTED" ]; then
              G9_FIRST=1  # R1b's guard file is not G9's; seed pool9 with the G9 lineage's pool
              if [ -f "$LOCAL/run/GUARD_TRIPPED" ]; then mv -f "$LOCAL/run/GUARD_TRIPPED" "$LOCAL/run/GUARD_TRIPPED.r1b" || true; fi
              mkdir -p "$LOCAL/run/pool9/frozen" || true
              cp -p "$NV2"/runs/g9/pool/*.pt "$LOCAL/run/pool9/" 2>/dev/null || true
              cp -p "$NV2"/runs/g9/pool/frozen/best-*.pt "$LOCAL/run/pool9/frozen/" 2>/dev/null || true
              date -u +%FT%T > "$NV2/runs/r1/G9_STARTED" || true
            fi
            if [ -f "$NV2/runs/r1/LINEAGE_DIRS" ] && [ -z "$G9_FIRST" ]; then
              nv2_lineage_dirs G9 "${LOCAL:-/tmp}/run/pool9"
              nv2_cfg_g9 28 g9a30 "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS --snapshot-cache 96 --stacked-opp"
              case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS${NV2_LIN_RESUME:+ --resume $NV2_LIN_RESUME}" ;; esac
            else
              nv2_cfg_g9 28 g9a30 "--n-battles 16 --pool-battles 16 --pool-dir ${LOCAL:-/tmp}/run/pool9"
              if [ -n "$G9_FIRST" ]; then TRAIN_ARGS="$TRAIN_ARGS --resume $G9_RES"; fi
            fi
          else
            if [ ! -f "$NV2/runs/g9/R1B_STARTED" ]; then rm -f "$NV2/runs/r1/R1B_PARKED" || true; fi  # R1b continues here: unpark
            nv2_cfg_r1b "${LOCAL:-}/pool" "--decoupled"
          fi ;;
  g9*)    CHAIN=3; MIN_CORES=8; N_SELFPLAY=16; N_POOL=16
          # init (deviation recorded in STATUS.md 02:12): P1 + its refit head = the refit best.pt
          G9_INIT=$NV2/runs/pretrain/g9h-dmg-s2-vrefit/best.pt
          if [ -f "$G9_INIT" ]; then RESUME=$G9_INIT; else RESUME=$G9_P1; fi
          PRE_CMD="bash scripts/netv2_g9_pre.sh"
          nv2_pool_trip g9
          if [ "$(cat "$NV2/runs/g9/MODE" 2>/dev/null || true)" = g9p ]; then nv2_second_trip g9 G9 g9a30; fi
          if [ "$(cat "$NV2/runs/g9/MODE" 2>/dev/null || true)" = g9s ]; then nv2_second_trip g9 G9s g9s; fi
          if [ "$(cat "$NV2/runs/g9/MODE" 2>/dev/null || true)" = g9q ]; then nv2_second_trip g9 G9q g9q; fi
          if [ "$(cat "$NV2/runs/g9/MODE" 2>/dev/null || true)" = g9p2 ]; then nv2_second_trip g9 G9p g9a30; fi
          if [ "$(cat "$NV2/runs/g9/MODE" 2>/dev/null || true)" = g9r ]; then nv2_second_trip g9 G9r g9r; fi
          if [ "$(cat "$NV2/runs/g9/MODE" 2>/dev/null || true)" = g9t ]; then nv2_second_trip g9 G9t g9t; fi
          if [ "$(cat "$NV2/runs/g9/MODE" 2>/dev/null || true)" = g9q2 ]; then nv2_second_trip g9 G9q2 g9q2; fi
          if [ "$(cat "$NV2/runs/g9/MODE" 2>/dev/null || true)" = g9p4 ]; then nv2_second_trip g9 G9P4 g9p4; fi
          nv2_pause g9
          nv2_swap g9
          G9_MODE=$(cat "$NV2/runs/g9/MODE" 2>/dev/null || echo g9)
          # v17 park guards (see the v17 note): a parked lineage never resumes; HOLD rounds until MODE changes
          nv2_g9_parked() { { [ "$G9_MODE" = g9q2 ] && [ -f "$NV2/runs/g9q2-parked/PARKED.txt" ]; } || { [ "$G9_MODE" = g9qbf ] && [ -f "$NV2/runs/g9qbf-parked/PARKED.txt" ]; } || { [ "$G9_MODE" = g9qent ] && [ -f "$NV2/runs/g9qent-parked/PARKED.txt" ]; } || { [ "$G9_MODE" = g9p4 ] && [ -f "$NV2/runs/g9p4-parked/PARKED.txt" ]; }; }
          NV2_PH_N=0
          while nv2_g9_parked; do
            if [ -z "${LOCAL:-}" ]; then G9_MODE=$G9_MODE-parked; break; fi
            NV2_PH_N=$((NV2_PH_N + 1))
            if [ -n "${NV2_PARK_HOLD_ROUNDS:-}" ] && [ "$NV2_PH_N" -gt "$NV2_PARK_HOLD_ROUNDS" ]; then echo "$(date -u +%T) park guard held $NV2_PARK_HOLD_ROUNDS rounds (mock cap): exit" >> "$LOCAL/run/train.log" || true; exit 3; fi
            touch "$NV2/runs/g9/HOLD" || true
            echo "$(date -u +%T) MODE $G9_MODE is parked (runs/$G9_MODE-parked/PARKED.txt), round $NV2_PH_N: HOLD, allocation kept — place the A40 (runs/g9/MODE), then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
            nv2_pause g9
            G9_MODE=$(cat "$NV2/runs/g9/MODE" 2>/dev/null || echo g9)
          done
          R1B_RES=$(head -n 1 "$NV2/runs/g9/R1B_RESUME" 2>/dev/null || true)
          G9P_H=$NV2/runs/r1/handover-g9p
          # MAIN-RUN RULE swap (STATUS.md, agent 4): MODE g9s = this A16 trains the G9s lineage (from scratch) from
          # 718701's handover runs/r1/handover-g9s-a16/ in its own lineage dir $LOCAL/run/G9s (8 workers, guard state
          # runs/g9s as before); no handover (yet) -> G9p continues here
          G9S_A16=$NV2/runs/r1/handover-g9s-a16
          # G9q (user decision 2026-11-10 00:45 = option A of runs/g9q/PROPOSAL-DRAFT.txt; pre-registered runs/g9q/PREREG.txt):
          # G9p's recipe with ONE change, the BC net P3 in all three roles (init, KL anchor 0.1 with the 50M decay, frozen +
          # --frozen-best), on this A16 in place of G9s (parked in runs/g9s-parked/); eval anchor P1 as for G9p / G9s. Lineage
          # dir $LOCAL/run/G9q, guard state runs/g9q (G9p's fallback rules, once; a second trip -> HOLD). First start from P3
          # (steps 0, fresh optimizer); then its own final_model.pt (restart in place) or, in a fresh job (the successor
          # 810367), its newest mirrored G9q file. A new run => November sets (decision 3a) for the fastenv collector only
          # (PORYGON_PS; the eval servers and the step-matched tests stay October); every other g9 mode unsets it (no set
          # change under G9s if it ever resumes here). Speed only, by GPU: 8 workers; cache 72 on the A16, 512 +
          # --stacked-opp on a >= 40 GB GPU (G9s's settings); successors through the wrapper with --snapshot-cache-cpu 200.
          # v9 swap (nv2_swap above): MODE g9p2 = this A16 trains the G9p lineage (G9p's recipe exactly: BC net P1, guard
          # state runs/g9a30, October sets) from 718701's handover runs/r1/handover-g9p-a16/ in the lineage dir
          # $LOCAL/run/G9p (no G9p dir on gpuvm36: never the stale run/G9); 8 workers, --no-overlap, no actor stream; cache
          # 72 on the A16, 512 + --stacked-opp on >= 40 GB; job 741849 and the successors through the 24c633f wrapper with
          # --snapshot-cache-cpu 200 (no wrapper: $C/src, no cpu tier). First start (runs/g9/G9P_A16_STARTED absent) only
          # from a DONE handover under DECISION COMMIT, else G9q continues here (its own local save).
          G9P_A16=$NV2/runs/r1/handover-g9p-a16
          if [ "$G9_MODE" = g9p2 ] && [ ! -f "$NV2/runs/g9/G9P_A16_STARTED" ] && ! nv2_swap_ready "$G9P_A16"; then
            if [ -n "${LOCAL:-}" ]; then echo "$(date -u +%T) MODE g9p2 but no committed G9p handover in $G9P_A16 (DECISION: $(nv2_swap_decision)): G9q continues" >> "$LOCAL/run/train.log" || true; fi
            G9_MODE=g9q
          fi
          # v14 (2026-11-12, G9t placement on the A16): a refusal with G9r PARKED (runs/g9r-parked/PARKED.txt, written by
          # scripts/netv2_g9t/inline-a16-park-g9r-start-g9t.sh) never falls back to G9r (that would fork the parked lineage):
          # train.log note, runs/g9/HOLD, nv2_pause g9 (allocation kept, <= 4 h per round), re-check, until the recipe
          # passes (fix runs/g9t, then rm runs/g9/HOLD). Not parked: v13 (refused -> G9r continues). Outside a job (LOCAL
          # unset: nothing can wait) -> no G9r either (the generic branch). NV2_G9T_HOLD_ROUNDS: the laptop mocks only.
          if [ "$G9_MODE" = g9t ] && [ -f "$NV2/runs/g9r-parked/PARKED.txt" ]; then
            NV2_G9T_HOLD_N=0
            while ! nv2_g9t_recipe g9 "HOLD: G9r is parked (runs/g9r-parked/PARKED.txt) and never resumes on a refusal; nothing"; do
              if [ -z "${LOCAL:-}" ]; then G9_MODE=g9t-held; break; fi
              NV2_G9T_HOLD_N=$((NV2_G9T_HOLD_N + 1))
              if [ -n "${NV2_G9T_HOLD_ROUNDS:-}" ] && [ "$NV2_G9T_HOLD_N" -gt "$NV2_G9T_HOLD_ROUNDS" ]; then echo "$(date -u +%T) MODE g9t held $NV2_G9T_HOLD_ROUNDS rounds (mock cap): exit" >> "$LOCAL/run/train.log" || true; exit 3; fi
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) MODE g9t refused with G9r parked (round $NV2_G9T_HOLD_N): HOLD — fix runs/g9t/RECIPE / G9T_STARTED, then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
            done
          elif [ "$G9_MODE" = g9t ] && ! nv2_g9t_recipe g9 G9r; then G9_MODE=g9r; fi  # v12 draft: refused -> G9r continues
          if [ "$G9_MODE" = g9q ] || [ "$G9_MODE" = g9r ] || [ "$G9_MODE" = g9t ] || [ "$G9_MODE" = g9q2 ] || [ "$G9_MODE" = g9qbf ] || [ "$G9_MODE" = g9qent ] || [ "$G9_MODE" = g9p4 ]; then export PORYGON_PS=/vol/bitbucket/fr1226/porygon-ws-fastenv/ps-2026-11; else unset PORYGON_PS; fi
          if [ "$G9_MODE" = g9s ] && [ ! -f "$NV2/runs/g9/G9S_A16_STARTED" ] && [ ! -f "$G9S_A16/final_model.pt" ]; then
            if [ -n "${LOCAL:-}" ]; then echo "$(date -u +%T) MODE g9s but no G9s handover in $G9S_A16: G9p continues" >> "$LOCAL/run/train.log" || true; fi
            G9_MODE=g9p
          fi
          if [ "$G9_MODE" = g9p2 ]; then
            G9P2_FIRST=""
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9/G9P_A16_STARTED" ]; then
              G9P2_FIRST=1
              mkdir -p "$LOCAL/run/G9p" || true
              if [ ! -d "$LOCAL/run/G9p/pool" ]; then cp -rp "$G9P_A16/pool" "$LOCAL/run/G9p/pool" || mkdir -p "$LOCAL/run/G9p/pool" || true; fi
              for f in best_model.pt ema_model.pt GUARD_TRIPPED; do if [ -f "$G9P_A16/$f" ]; then cp -p "$G9P_A16/$f" "$LOCAL/run/G9p/$f" || true; fi; done
              date -u +%FT%T > "$NV2/runs/g9/G9P_A16_STARTED" || true
              echo "$(date -u +%T) G9p first start on this A16 from $G9P_A16 (pool + best / ema copied); October sets" >> "$LOCAL/run/train.log" || true
            fi
            nv2_lineage_dirs G9p ""
            if [ -n "$G9P2_FIRST" ]; then NV2_LIN_RESUME=$G9P_A16/final_model.pt; fi  # first start: the handover state
            NV2_G9P2_OPP="--snapshot-cache 72"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9P2_OPP="--snapshot-cache 512 --stacked-opp"; fi
            if { [ "${SLURM_JOB_ID:-}" = 741849 ] && [ -x "$NV2_SUCC_PY" ]; } || nv2_successor; then PY=$NV2_SUCC_PY; NV2_G9P2_OPP="$NV2_G9P2_OPP --snapshot-cache-cpu 200"; fi
            nv2_cfg_g9 8 g9a30 "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS $NV2_G9P2_OPP"
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9P_A16/final_model.pt}" ;; esac
          elif [ "$G9_MODE" = g9r ]; then
            # v10: G9r (see the v10 note above nv2_deadline_watch)
            mkdir -p "$NV2/runs/g9r" || true
            if [ ! -x "$NV2_G9R_PY" ] && [ -n "${LOCAL:-}" ]; then
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) MODE g9r but no $NV2_G9R_PY (G9r's src): HOLD — install it, then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
            fi
            G9R_FIRST=""
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9r/G9R_STARTED" ]; then
              G9R_FIRST=1
              mkdir -p "$LOCAL/run/G9r/pool" || true
              date -u +%FT%T > "$NV2/runs/g9r/G9R_STARTED" || true
              echo "$(date -u +%T) G9r first start: from P3 $G9_P3 (steps 0); lr schedule power H=300000000, entropy floor 0.35; November sets for the collector (PORYGON_PS=$PORYGON_PS)" >> "$LOCAL/run/train.log" || true
            fi
            nv2_lineage_dirs G9r ""
            if [ -n "$G9R_FIRST" ]; then NV2_LIN_RESUME=$G9_P3  # first start: the BC init (never the job's top-level file)
            elif [ -z "$NV2_LIN_RESUME" ] && [ -n "${LOCAL:-}" ]; then
              # no G9r final_model.pt in this job (the job's top-level file skips nv2_lineage_dirs' mirror search):
              # G9r's newest checkpoint, local or mirrored; none at all = it never saved (a crash before its first save)
              NV2_LIN_RESUME=$(ls -t "$LOCAL"/run/G9r/checkpoints/*.pt "$NV2"/runs/*/*/G9r/checkpoints/*.pt "$NV2"/runs/*/*/G9r/final_model.pt 2>/dev/null | head -n 1 || true)
              echo "$(date -u +%T) G9r: no final_model.pt of its own here: resuming ${NV2_LIN_RESUME:-P3 again (no G9r save anywhere)}" >> "$LOCAL/run/train.log" || true
            fi
            PY=$NV2_G9R_PY
            NV2_G9R_OPP="--snapshot-cache 72"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9R_OPP="--snapshot-cache 512 --stacked-opp"; fi
            nv2_cfg_g9 8 g9r "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS $NV2_G9R_OPP --snapshot-cache-cpu 200 --lr-schedule power --lr-horizon 300000000" "$G9_P3"
            case $TRAIN_ARGS in
              *" --guard-entropy-min 0.5 "*) TRAIN_ARGS="${TRAIN_ARGS/ --guard-entropy-min 0.5 / --guard-entropy-min 0.35 }" ;;
              *) TRAIN_ARGS="$TRAIN_ARGS --guard-entropy-min 0.35" ;;  # (argparse: the last one wins)
            esac
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9_P3}" ;; esac
          elif [ "$G9_MODE" = g9t ]; then
            # v12 draft: G9t on the A16 (see the v12 note above nv2_g9t_parse): G9r's per-GPU settings
            NV2_G9T_OPP="--snapshot-cache 72"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9T_OPP="--snapshot-cache 512 --stacked-opp"; fi
            nv2_cfg_g9t g9 8 "$NV2_G9T_OPP --snapshot-cache-cpu 200"
          elif [ "$G9_MODE" = g9p4 ]; then
            # v19: G9-P4 (see the v19 note): G9q2's branch (G9q's recipe on this GPU), own lineage G9P4 / state runs/g9p4,
            # unseeded, the BC net P4 in all three roles
            mkdir -p "$NV2/runs/g9p4" || true
            if [ ! -x "$NV2_SUCC_PY" ] && [ -n "${LOCAL:-}" ]; then
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) MODE g9p4 but no $NV2_SUCC_PY (G9-P4's src): HOLD — install it, then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
            fi
            nv2_p4_ok() { local m=""; read -r m < "$NV2/runs/g9p4/P4.md5" 2> /dev/null || true; [ -n "$m" ] && [ -f "$G9_P4" ] && [ ! -w "$G9_P4" ] && [ "$(md5sum < "$G9_P4" 2> /dev/null | cut -c1-8 || true)" = "$m" ]; }
            G9P4_FIRST=""
            NV2_P4_N=0
            while [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9p4/G9P4_STARTED" ]; do
              if nv2_p4_ok; then
                G9P4_FIRST=1
                mkdir -p "$LOCAL/run/G9P4/pool" || true
                echo "$(date -u +%FT%T) $(cat "$NV2/runs/g9p4/P4.md5" 2> /dev/null || true) g9 ${SLURM_JOB_ID:-}" > "$NV2/runs/g9p4/G9P4_STARTED" || true
                echo "$(date -u +%T) G9-P4 first start: from BC-P4 $G9_P4 (md5 $(cat "$NV2/runs/g9p4/P4.md5" 2> /dev/null || true); steps 0); G9q's recipe with BC-P4 as init, KL anchor and frozen net; unseeded; November sets for the collector (PORYGON_PS=${PORYGON_PS:-})" >> "$LOCAL/run/train.log" || true
                break
              fi
              NV2_P4_N=$((NV2_P4_N + 1))
              if [ -n "${NV2_PARK_HOLD_ROUNDS:-}" ] && [ "$NV2_P4_N" -gt "$NV2_PARK_HOLD_ROUNDS" ]; then echo "$(date -u +%T) MODE g9p4 first start held $NV2_PARK_HOLD_ROUNDS rounds (mock cap): exit" >> "$LOCAL/run/train.log" || true; exit 3; fi
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) MODE g9p4: no valid BC-P4 ($G9_P4 missing, writable or md5 not runs/g9p4/P4.md5), round $NV2_P4_N: HOLD — fix it, then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
            done
            nv2_lineage_dirs G9P4 ""
            if [ -n "$G9P4_FIRST" ]; then NV2_LIN_RESUME=$G9_P4  # first start: the BC init (never the job's top-level file)
            elif [ -z "$NV2_LIN_RESUME" ] && [ -n "${LOCAL:-}" ]; then
              NV2_LIN_RESUME=$(ls -t "$LOCAL"/run/G9P4/checkpoints/*.pt "$NV2"/runs/*/*/G9P4/checkpoints/*.pt "$NV2"/runs/*/*/G9P4/final_model.pt 2>/dev/null | head -n 1 || true)
              echo "$(date -u +%T) G9-P4: no final_model.pt of its own here: resuming ${NV2_LIN_RESUME:-BC-P4 again (no G9P4 save anywhere)}" >> "$LOCAL/run/train.log" || true
            fi
            PY=$NV2_SUCC_PY
            NV2_G9P4_OPP="--snapshot-cache 72"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9P4_OPP="--snapshot-cache 512 --stacked-opp"; fi
            nv2_cfg_g9 8 g9p4 "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS $NV2_G9P4_OPP --snapshot-cache-cpu 200" "$G9_P4"
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9_P4}" ;; esac
          elif [ "$G9_MODE" = g9qent ]; then
            # v18: the entropy-schedule arm G9qent (see the v18 note): G9q2's branch, own lineage / state, unseeded,
            # through src-8892762, + the linear ent schedule from the fork step and the entropy floor 0.35
            NV2_ENT_PY=$NV2/bin/py-src-8892762
            mkdir -p "$NV2/runs/g9qent" || true
            if [ ! -x "$NV2_ENT_PY" ] && [ -n "${LOCAL:-}" ]; then
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) MODE g9qent but no $NV2_ENT_PY (G9qent's src): HOLD — install it, then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
            fi
            if [ -n "${LOCAL:-}" ] && [ -f "$LOCAL/run/G9qent/GUARD_TRIPPED" ]; then  # no fallback in an A/B arm: record, HOLD, same config
              cp -f "$LOCAL/run/G9qent/GUARD_TRIPPED" "$NV2/runs/g9qent/TRIPPED" || true
              mv -f "$LOCAL/run/G9qent/GUARD_TRIPPED" "$LOCAL/run/G9qent/GUARD_TRIPPED.ab-$(date -u +%H%M%S)" || true
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) G9qent guard trip ($(head -c 160 "$NV2/runs/g9qent/TRIPPED" 2>/dev/null || true)): no fallback (A/B arm): HOLD, then the same config" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
            fi
            G9QENT_FIRST=""
            NV2_EP_P="" NV2_EP_S="" NV2_EP_M=""
            read -r NV2_EP_P NV2_EP_S NV2_EP_M < "$NV2/runs/g9qent/FORK_POINT" 2> /dev/null || true
            case $NV2_EP_S in ""|*[!0-9]*) NV2_EP_S="" ;; esac
            NV2_EP_N=0
            while [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9qent/G9QENT_STARTED" ]; do
              if [ -n "$NV2_EP_S" ] && [ -n "$NV2_EP_P" ] && [ -f "$NV2_EP_P" ] && [ -f "$LOCAL/run/G9qent/.staged-$NV2_EP_S" ] && [ "$(md5sum < "$NV2_EP_P" 2> /dev/null | cut -c1-8 || true)" = "$NV2_EP_M" ]; then
                G9QENT_FIRST=1
                echo "$(date -u +%FT%T) $NV2_EP_S g9 ${SLURM_JOB_ID:-}" > "$NV2/runs/g9qent/G9QENT_STARTED" || true
                echo "$(date -u +%T) G9qent first start: the fork of G9q at $NV2_EP_S ($NV2_EP_P, md5 $NV2_EP_M); G9q's recipe + ent schedule linear 0.01 -> 0.001 over [$NV2_EP_S, $((NV2_EP_S + 50000000))], entropy floor 0.35; unseeded; staged pool; November sets (PORYGON_PS=${PORYGON_PS:-})" >> "$LOCAL/run/train.log" || true
                break
              fi
              NV2_EP_N=$((NV2_EP_N + 1))
              if [ -n "${NV2_PARK_HOLD_ROUNDS:-}" ] && [ "$NV2_EP_N" -gt "$NV2_PARK_HOLD_ROUNDS" ]; then echo "$(date -u +%T) MODE g9qent first start held $NV2_PARK_HOLD_ROUNDS rounds (mock cap): exit" >> "$LOCAL/run/train.log" || true; exit 3; fi
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) MODE g9qent: no valid first start (runs/g9qent/FORK_POINT '$NV2_EP_P $NV2_EP_S $NV2_EP_M', staged pool marker $LOCAL/run/G9qent/.staged-${NV2_EP_S:-?}), round $NV2_EP_N: HOLD — fix it, then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
              read -r NV2_EP_P NV2_EP_S NV2_EP_M < "$NV2/runs/g9qent/FORK_POINT" 2> /dev/null || true
              case $NV2_EP_S in ""|*[!0-9]*) NV2_EP_S="" ;; esac
            done
            nv2_lineage_dirs G9qent ""
            if [ -n "$G9QENT_FIRST" ]; then NV2_LIN_RESUME=$NV2_EP_P  # first start: the fork point (never the job's top-level file)
            elif [ -z "$NV2_LIN_RESUME" ] && [ -n "${LOCAL:-}" ]; then
              NV2_LIN_RESUME=$(ls -t "$LOCAL"/run/G9qent/checkpoints/*.pt "$NV2"/runs/*/*/G9qent/checkpoints/*.pt "$NV2"/runs/*/*/G9qent/final_model.pt 2>/dev/null | head -n 1 || true)
              echo "$(date -u +%T) G9qent: no final_model.pt of its own here: resuming ${NV2_LIN_RESUME:-the fork point again (no G9qent save anywhere)}" >> "$LOCAL/run/train.log" || true
            fi
            PY=$NV2_ENT_PY
            NV2_G9QENT_OPP="--snapshot-cache 72"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9QENT_OPP="--snapshot-cache 512 --stacked-opp"; fi
            nv2_cfg_g9 8 g9qent "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS $NV2_G9QENT_OPP --snapshot-cache-cpu 200 --ent-schedule linear --ent-final 0.001 --ent-start ${NV2_EP_S:-0} --ent-horizon 50000000" "$G9_P3"
            TRAIN_ARGS="${TRAIN_ARGS/ --guard-entropy-min 0.5 / --guard-entropy-min 0.35 }"  # forced by the schedule (lower entropy)
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$NV2_EP_P}" ;; esac
          elif [ "$G9_MODE" = g9qbf ]; then
            # v17: the bf16 fork G9qbf (see the v17 note): G9q2's branch, own lineage / state, unseeded, --no-bf16 dropped
            mkdir -p "$NV2/runs/g9qbf" || true
            if [ ! -x "$NV2_SUCC_PY" ] && [ -n "${LOCAL:-}" ]; then
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) MODE g9qbf but no $NV2_SUCC_PY (G9qbf's src): HOLD — install it, then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
            fi
            if [ -n "${LOCAL:-}" ] && [ -f "$LOCAL/run/G9qbf/GUARD_TRIPPED" ]; then  # no fallback in an A/B arm: record, HOLD, same config
              cp -f "$LOCAL/run/G9qbf/GUARD_TRIPPED" "$NV2/runs/g9qbf/TRIPPED" || true
              mv -f "$LOCAL/run/G9qbf/GUARD_TRIPPED" "$LOCAL/run/G9qbf/GUARD_TRIPPED.ab-$(date -u +%H%M%S)" || true
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) G9qbf guard trip ($(head -c 160 "$NV2/runs/g9qbf/TRIPPED" 2>/dev/null || true)): no fallback (A/B arm): HOLD, then the same config" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
            fi
            G9QBF_FIRST=""
            NV2_FP_P="" NV2_FP_S="" NV2_FP_M=""
            read -r NV2_FP_P NV2_FP_S NV2_FP_M < "$NV2/runs/g9qbf/FORK_POINT" 2> /dev/null || true
            case $NV2_FP_S in ""|*[!0-9]*) NV2_FP_S="" ;; esac
            NV2_FP_N=0
            while [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9qbf/G9QBF_STARTED" ]; do
              if [ -n "$NV2_FP_S" ] && [ -n "$NV2_FP_P" ] && [ -f "$NV2_FP_P" ] && [ -f "$LOCAL/run/G9qbf/.staged-$NV2_FP_S" ] && [ "$(md5sum < "$NV2_FP_P" 2> /dev/null | cut -c1-8 || true)" = "$NV2_FP_M" ]; then
                G9QBF_FIRST=1
                echo "$(date -u +%FT%T) $NV2_FP_S g9 ${SLURM_JOB_ID:-}" > "$NV2/runs/g9qbf/G9QBF_STARTED" || true
                echo "$(date -u +%T) G9qbf first start: the fork of G9q at $NV2_FP_S ($NV2_FP_P, md5 $NV2_FP_M); G9q's recipe + bf16 autocast (--no-bf16 dropped), unseeded; staged pool; November sets (PORYGON_PS=${PORYGON_PS:-})" >> "$LOCAL/run/train.log" || true
                break
              fi
              NV2_FP_N=$((NV2_FP_N + 1))
              if [ -n "${NV2_PARK_HOLD_ROUNDS:-}" ] && [ "$NV2_FP_N" -gt "$NV2_PARK_HOLD_ROUNDS" ]; then echo "$(date -u +%T) MODE g9qbf first start held $NV2_PARK_HOLD_ROUNDS rounds (mock cap): exit" >> "$LOCAL/run/train.log" || true; exit 3; fi
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) MODE g9qbf: no valid first start (runs/g9qbf/FORK_POINT '$NV2_FP_P $NV2_FP_S $NV2_FP_M', staged pool marker $LOCAL/run/G9qbf/.staged-${NV2_FP_S:-?}), round $NV2_FP_N: HOLD — fix it, then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
              read -r NV2_FP_P NV2_FP_S NV2_FP_M < "$NV2/runs/g9qbf/FORK_POINT" 2> /dev/null || true
              case $NV2_FP_S in ""|*[!0-9]*) NV2_FP_S="" ;; esac
            done
            nv2_lineage_dirs G9qbf ""
            if [ -n "$G9QBF_FIRST" ]; then NV2_LIN_RESUME=$NV2_FP_P  # first start: the fork point (never the job's top-level file)
            elif [ -z "$NV2_LIN_RESUME" ] && [ -n "${LOCAL:-}" ]; then
              NV2_LIN_RESUME=$(ls -t "$LOCAL"/run/G9qbf/checkpoints/*.pt "$NV2"/runs/*/*/G9qbf/checkpoints/*.pt "$NV2"/runs/*/*/G9qbf/final_model.pt 2>/dev/null | head -n 1 || true)
              echo "$(date -u +%T) G9qbf: no final_model.pt of its own here: resuming ${NV2_LIN_RESUME:-the fork point again (no G9qbf save anywhere)}" >> "$LOCAL/run/train.log" || true
            fi
            PY=$NV2_SUCC_PY
            NV2_G9QBF_OPP="--snapshot-cache 72"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9QBF_OPP="--snapshot-cache 512 --stacked-opp"; fi
            nv2_cfg_g9 8 g9qbf "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS $NV2_G9QBF_OPP --snapshot-cache-cpu 200" "$G9_P3"
            TRAIN_ARGS="${TRAIN_ARGS/--no-bf16 /}"  # THE ONE CHANGE: bf16 autocast (the trainer's default)
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$NV2_FP_P}" ;; esac
          elif [ "$G9_MODE" = g9q2 ]; then
            # v15: G9q2 (see the v15 note above the opponent-cache notes): G9q's A16 branch, own lineage / state, seed
            mkdir -p "$NV2/runs/g9q2" || true
            if [ ! -x "$NV2_SUCC_PY" ] && [ -n "${LOCAL:-}" ]; then
              touch "$NV2/runs/g9/HOLD" || true
              echo "$(date -u +%T) MODE g9q2 but no $NV2_SUCC_PY (G9q2's src): HOLD — install it, then rm runs/g9/HOLD" >> "$LOCAL/run/train.log" || true
              nv2_pause g9
            fi
            G9Q2_FIRST=""
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9q2/G9Q2_STARTED" ]; then
              G9Q2_FIRST=1
              mkdir -p "$LOCAL/run/G9q2/pool" || true
              echo "$(date -u +%FT%T) seed $NV2_G9Q2_SEED g9 ${SLURM_JOB_ID:-}" > "$NV2/runs/g9q2/G9Q2_STARTED" || true
              echo "$(date -u +%T) G9q2 first start: from P3 $G9_P3 (steps 0); G9q's recipe + --seed $NV2_G9Q2_SEED (this start only); November sets for the collector (PORYGON_PS=$PORYGON_PS)" >> "$LOCAL/run/train.log" || true
            fi
            nv2_lineage_dirs G9q2 ""
            if [ -n "$G9Q2_FIRST" ]; then NV2_LIN_RESUME=$G9_P3  # first start: the BC init (never the job's top-level file)
            elif [ -z "$NV2_LIN_RESUME" ] && [ -n "${LOCAL:-}" ]; then
              # no G9q2 final_model.pt in this job (the job's top-level file skips nv2_lineage_dirs' mirror search):
              # G9q2's newest checkpoint, local or mirrored; none at all = it never saved (a crash before its first save)
              NV2_LIN_RESUME=$(ls -t "$LOCAL"/run/G9q2/checkpoints/*.pt "$NV2"/runs/*/*/G9q2/checkpoints/*.pt "$NV2"/runs/*/*/G9q2/final_model.pt 2>/dev/null | head -n 1 || true)
              echo "$(date -u +%T) G9q2: no final_model.pt of its own here: resuming ${NV2_LIN_RESUME:-P3 again (no G9q2 save anywhere)}" >> "$LOCAL/run/train.log" || true
            fi
            PY=$NV2_SUCC_PY
            NV2_G9Q2_OPP="--snapshot-cache 72"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9Q2_OPP="--snapshot-cache 512 --stacked-opp"; fi
            nv2_cfg_g9 8 g9q2 "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS $NV2_G9Q2_OPP --snapshot-cache-cpu 200${G9Q2_FIRST:+ --seed $NV2_G9Q2_SEED}" "$G9_P3"
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9_P3}" ;; esac
          elif [ "$G9_MODE" = g9q ]; then
            mkdir -p "$NV2/runs/g9q" || true
            G9Q_FIRST=""
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9q/G9Q_STARTED" ]; then
              G9Q_FIRST=1
              mkdir -p "$LOCAL/run/G9q/pool" || true
              date -u +%FT%T > "$NV2/runs/g9q/G9Q_STARTED" || true
              echo "$(date -u +%T) G9q first start: from P3 $G9_P3 (steps 0); November sets for the collector (PORYGON_PS=$PORYGON_PS)" >> "$LOCAL/run/train.log" || true
            fi
            nv2_lineage_dirs G9q ""
            if [ -n "$G9Q_FIRST" ]; then NV2_LIN_RESUME=$G9_P3; fi  # first start: the BC init (never the job's top-level file)
            NV2_G9Q_OPP="--snapshot-cache 72"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9Q_OPP="--snapshot-cache 512 --stacked-opp"; fi
            if nv2_successor; then PY=$NV2_SUCC_PY; NV2_G9Q_OPP="$NV2_G9Q_OPP --snapshot-cache-cpu 200"; fi
            nv2_cfg_g9 8 g9q "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS $NV2_G9Q_OPP" "$G9_P3"
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9_P3}" ;; esac
          elif [ "$G9_MODE" = g9s ]; then
            G9S_FIRST=""
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9/G9S_A16_STARTED" ]; then
              G9S_FIRST=1
              mkdir -p "$LOCAL/run/G9s" || true
              if [ ! -d "$LOCAL/run/G9s/pool" ]; then cp -rp "$G9S_A16/pool" "$LOCAL/run/G9s/pool" || mkdir -p "$LOCAL/run/G9s/pool" || true; fi
              for f in best_model.pt ema_model.pt GUARD_TRIPPED; do if [ -f "$G9S_A16/$f" ]; then cp -p "$G9S_A16/$f" "$LOCAL/run/G9s/$f" || true; fi; done
              date -u +%FT%T > "$NV2/runs/g9/G9S_A16_STARTED" || true
            fi
            nv2_lineage_dirs G9s ""
            if [ -n "$G9S_FIRST" ]; then NV2_LIN_RESUME=$G9S_A16/final_model.pt; fi  # first start: the handover state
            NV2_G9S_OPP="--snapshot-cache 72"; if [ "${NV2_GPU_MIB:-0}" -ge 40000 ]; then NV2_G9S_OPP="--snapshot-cache 512 --stacked-opp"; fi
            if nv2_successor; then PY=$NV2_SUCC_PY; NV2_G9S_OPP="$NV2_G9S_OPP --snapshot-cache-cpu 200"; fi
            nv2_cfg_g9s 8 "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS $NV2_G9S_OPP"
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9S_A16/final_model.pt}" ;; esac
          elif [ "$G9_MODE" = g9p ] && { [ -f "$NV2/runs/g9/G9P_STARTED" ] || [ -f "$G9P_H/final_model.pt" ]; }; then
            # G9p (04:58, STATUS.md) = the P1-init G9 lineage, unchanged, on this A16 from 718701's handover (trainer
            # state + pool + best / ema); lineage dir $LOCAL/run/G9, guard state runs/g9a30 (the lineage's). If the
            # handover never came (WAIT_FOR timed out), the r1b branch below keeps training R1b-F instead.
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9/G9P_STARTED" ]; then
              mkdir -p "$LOCAL/run/G9" || true
              if [ ! -d "$LOCAL/run/G9/pool" ]; then cp -rp "$G9P_H/pool" "$LOCAL/run/G9/pool" || mkdir -p "$LOCAL/run/G9/pool" || true; fi
              for f in best_model.pt ema_model.pt; do if [ -f "$G9P_H/$f" ]; then cp -p "$G9P_H/$f" "$LOCAL/run/G9/$f" || true; fi; done
              date -u +%FT%T > "$NV2/runs/g9/G9P_STARTED" || true
            fi
            nv2_lineage_dirs G9 ""
            nv2_cfg_g9 8 g9a30 "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS --snapshot-cache 32"
            case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9P_H/final_model.pt}" ;; esac
          elif { [ "$G9_MODE" = r1b ] || [ "$G9_MODE" = g9p ]; } && { [ -f "$NV2/runs/g9/R1B_STARTED" ] || { [ -n "$R1B_RES" ] && [ -f "$R1B_RES" ] && [ -f "$NV2/runs/r1/R1B_PARKED" ]; }; }; then
            # this (A16) allocation trains the R1b lineage (gen4, fastenv 8 workers, on-policy) from runs/g9/R1B_RESUME
            R1B_FIRST=""
            if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g9/R1B_STARTED" ]; then
              R1B_FIRST=1
              if [ -f "$LOCAL/run/GUARD_TRIPPED" ]; then mv -f "$LOCAL/run/GUARD_TRIPPED" "$LOCAL/run/GUARD_TRIPPED.g9" || true; fi
              mkdir -p "$LOCAL/run/pool4" || true
              cp -p "$NV2"/runs/r1/pool/*.pt "$LOCAL/run/pool4/" 2>/dev/null || true
              date -u +%FT%T > "$NV2/runs/g9/R1B_STARTED" || true
            fi
            if [ -f "$NV2/runs/g9/LINEAGE_DIRS" ] && [ -z "$R1B_FIRST" ]; then
              nv2_lineage_dirs R1b "${LOCAL:-/tmp}/run/pool4"
              nv2_cfg_r1b "${LOCAL:-/tmp}/run/R1b/pool" "--collector fastenv --fastenv-workers 8 --fastenv-battles 48 --no-overlap --n-battles 60 --pool-battles 30 $NV2_LIN_ARGS"
              case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS${NV2_LIN_RESUME:+ --resume $NV2_LIN_RESUME}" ;; esac  # a follow-up start (--resume 7.5M) wins
            else
              nv2_cfg_r1b "${LOCAL:-/tmp}/run/pool4" "--collector fastenv --fastenv-workers 8 --fastenv-battles 48 --no-overlap --n-battles 60 --pool-battles 30 --pool-dir ${LOCAL:-/tmp}/run/pool4"
              if [ -n "$R1B_FIRST" ] && [ -z "$NV2_FU_FIRST" ]; then TRAIN_ARGS="$TRAIN_ARGS --resume $R1B_RES"; fi
            fi
          else
            nv2_cfg_g9 8 g9 ""
          fi ;;
  g4r1bf*) # R1b-F (gen4: R1b recipe + working pool) RESUMED 2026-11-09 evening as netv2's helper job on a dove T4
          # (--partition=training, 10 CPUs, chained 3-day jobs; user decision 2b, 17:00: "resume as is" with a strength
          # watch). Recipe = what it ran with on 741849 (nv2_cfg_r1b + its fastenv extra, 8 workers, lineage dir now
          # R1bF); first start from runs/r1b-parked/ (20,883,993 steps: final_model.pt, pool, best / ema).
          # Decision 3a: November sets at this resume = fastenv's ps-2026-11 build (a78551b, levels only) for the
          # trainer's fastenv collector (PORYGON_PS); the in-training evals stay on $ROOT/pokemon-showdown (October;
          # fastenv's advice: a server writes into its dir). Speed only: --snapshot-cache 40 (default 8 < its pool).
          # Strength watch (user rule): --guard-anchor-drop 0.0999 = the eval win rate vs v1@46M >= 10 points below
          # its best for 2 consecutive evals (on the 0.5-point grid of 200-game evals; subsumes the recipe's 0.15);
          # EVERY non-pool trip -> follow-up #1 (nv2_cfg_r1b: --ent-coef 0 --zero-avoid-coef 0 from
          # runs/r1/restart-best-7.5M.pt, state runs/r1/FU.*); a trip of the follow-up -> HOLD (nv2_second_trip).
          CHAIN=3; MIN_CORES=10; N_SELFPLAY=16; N_POOL=16
          export PORYGON_PS=/vol/bitbucket/fr1226/porygon-ws-fastenv/ps-2026-11
          R1BF_PARK=$NV2/runs/r1b-parked
          mkdir -p "$NV2/runs/g4r1bf" || true
          nv2_pool_trip g4r1bf
          nv2_second_trip g4r1bf R1bF r1
          nv2_pause g4r1bf
          if [ -n "${LOCAL:-}" ] && [ -f "$LOCAL/run/R1bF/GUARD_TRIPPED" ] && [ ! -f "$NV2/runs/r1/FU.started" ]; then
            cp -f "$LOCAL/run/R1bF/GUARD_TRIPPED" "$NV2/runs/g4r1bf/FU.reason" || true
            mv -f "$LOCAL/run/R1bF/GUARD_TRIPPED" "$LOCAL/run/R1bF/GUARD_TRIPPED.fu-$(date -u +%H%M%S)" || true
            touch "$NV2/runs/r1/FOLLOWUP1" || true
            echo "$(date -u +%T) R1b-F guard trip ($(head -c 200 "$NV2/runs/g4r1bf/FU.reason" 2>/dev/null || true)): follow-up #1 (user rule)" >> "$LOCAL/run/train.log" || true
          fi
          R1BF_FIRST=""
          if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2/runs/g4r1bf/R1BF_STARTED" ]; then
            R1BF_FIRST=1
            mkdir -p "$LOCAL/run/R1bF" || true
            if [ ! -d "$LOCAL/run/R1bF/pool" ]; then cp -rp "$R1BF_PARK/pool" "$LOCAL/run/R1bF/pool" || mkdir -p "$LOCAL/run/R1bF/pool" || true; fi
            for f in best_model.pt ema_model.pt; do if [ -f "$R1BF_PARK/$f" ] && [ ! -e "$LOCAL/run/R1bF/$f" ]; then cp -p "$R1BF_PARK/$f" "$LOCAL/run/R1bF/$f" || true; fi; done
            date -u +%FT%T > "$NV2/runs/g4r1bf/R1BF_STARTED" || true
            echo "$(date -u +%T) R1b-F resume: first start from $R1BF_PARK (pool + best / ema copied); November sets (PORYGON_PS=$PORYGON_PS) for the collector, October eval servers" >> "$LOCAL/run/train.log" || true
          fi
          nv2_lineage_dirs R1bF ""
          if [ -n "$R1BF_FIRST" ]; then NV2_LIN_RESUME=$R1BF_PARK/final_model.pt; fi  # first start: the parked state
          # v7 (2026-11-10, orchestrator-approved; speed only): R1b-F (job 829660 from its next restart in place, and its
          # chained jobs) runs the trainer through the 24c633f wrapper with --stacked-opp (frozen nets stacked apart,
          # fused slot fills; logits-equivalent). T4 check 11:2x: OppStack 16.1 MiB per gen4 net = 645 MiB at its
          # --snapshot-cache 40 vs ~1.5 GiB free beside the trainer's 13.8 GiB; a stacked-forward error falls back to
          # per-net forwards. Without the wrapper: $C/src and no --stacked-opp (as before).
          # v11 (2026-11-12 ~01:40, orchestrator-APPROVED; speed only): + --snapshot-cache-cpu 200 through the wrapper (CPU
          # tier: pool 64 > GPU cache 40 made pool/load_attempts_snapshot rise 0.8 -> ~300 per update and col_opp_fwd_s
          # 8.5 -> 50 s; same nets and logits; 23 MB per gen4 net, <= 4.6 GB at 200 vs the job's 40G).
          NV2_R1BF_OPP=""; if [ -x "$NV2_SUCC_PY" ]; then PY=$NV2_SUCC_PY; NV2_R1BF_OPP=" --stacked-opp --snapshot-cache-cpu 200"; fi
          nv2_cfg_r1b "${LOCAL:-/tmp}/run/R1bF/pool" "--collector fastenv --fastenv-workers 8 --fastenv-battles 48 --no-overlap --n-battles 60 --pool-battles 30 $NV2_LIN_ARGS --snapshot-cache 40$NV2_R1BF_OPP"
          TRAIN_ARGS="$TRAIN_ARGS --guard-anchor-drop 0.0999"
          # v16 (2026-11-15, orchestrator decision ~20:40; runs/g4r1bf/HOLD-PREREG.txt af0441c6): R1b-F ROLLBACK hook, inert
          # unless runs/g4r1bf/ROLLBACK exists (one line "PATH STEP MD5", written only by scripts/netv2_g4r1bf/hold-chain.sh
          # after a trip whose T1 was "clearly worse than R1b-F@300M"). Once runs/g4r1bf/ROLLBACK.started exists: --lr 3.5e-5
          # in place of --lr 7e-5 at every (re)start (R1b-F's own final_model.pt). The FIRST relaunch inside a job (marker
          # absent): PATH readable, STEP numeric and md5 = MD5 => marker, --lr 3.5e-5, --resume PATH, and the pool snapshots
          # newer than STEP (local lineage pool and this job's mirrored one) moved to runs/g4r1bf/pool-after-rollback/; else
          # no rollback: runs/g4r1bf/HOLD + note, nv2_pause, the same config (lr 7e-5, own final) continues. No file: unchanged.
          nv2_rb_park() {  # nv2_rb_park STEP DIR: snapshots (numeric names) newer than STEP -> runs/g4r1bf/pool-after-rollback/
            local f n
            mkdir -p "$NV2/runs/g4r1bf/pool-after-rollback" || true
            for f in "$2"/*.pt; do
              [ -e "$f" ] || continue
              n=$(basename "$f" .pt); case $n in *[!0-9]*|"") continue ;; esac
              if [ "$((10#$n))" -gt "$1" ]; then mv -f "$f" "$NV2/runs/g4r1bf/pool-after-rollback/" || true; fi
            done
            return 0
          }
          if [ -f "$NV2/runs/g4r1bf/ROLLBACK.started" ]; then
            TRAIN_ARGS="${TRAIN_ARGS/--lr 7e-5/--lr 3.5e-5}"
          elif [ -f "$NV2/runs/g4r1bf/ROLLBACK" ] && [ -n "${LOCAL:-}" ]; then
            NV2_RB_P="" NV2_RB_S="" NV2_RB_M=""
            read -r NV2_RB_P NV2_RB_S NV2_RB_M < "$NV2/runs/g4r1bf/ROLLBACK" || true
            case $NV2_RB_S in ""|*[!0-9]*) NV2_RB_S="" ;; esac
            if [ -n "$NV2_RB_S" ] && [ -n "$NV2_RB_P" ] && [ -f "$NV2_RB_P" ] && [ "$(md5sum < "$NV2_RB_P" 2> /dev/null | cut -c1-8 || true)" = "$NV2_RB_M" ]; then
              echo "$(date -u +%FT%T) $NV2_RB_P $NV2_RB_S $NV2_RB_M ${SLURM_JOB_ID:-}" > "$NV2/runs/g4r1bf/ROLLBACK.started" || true
              nv2_rb_park "$NV2_RB_S" "$LOCAL/run/R1bF/pool"
              for NV2_RB_D in "$NV2"/runs/g4r1bf/*-"${SLURM_JOB_ID:-none}"/R1bF/pool; do if [ -d "$NV2_RB_D" ]; then nv2_rb_park "$NV2_RB_S" "$NV2_RB_D"; fi; done
              TRAIN_ARGS="${TRAIN_ARGS/--lr 7e-5/--lr 3.5e-5} --resume $NV2_RB_P"
              echo "$(date -u +%T) R1b-F ROLLBACK (runs/g4r1bf/ROLLBACK): resume $NV2_RB_P (steps $NV2_RB_S) at --lr 3.5e-5; pool snapshots > $NV2_RB_S moved to runs/g4r1bf/pool-after-rollback/" >> "$LOCAL/run/train.log" || true
            else
              touch "$NV2/runs/g4r1bf/HOLD" || true
              echo "$(date -u +%T) R1b-F ROLLBACK refused (runs/g4r1bf/ROLLBACK '$NV2_RB_P $NV2_RB_S $NV2_RB_M': missing file, bad step or md5 mismatch): HOLD, then the same config" >> "$LOCAL/run/train.log" || true
              nv2_pause g4r1bf
            fi
          fi
          case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$R1BF_PARK/final_model.pt}" ;; esac ;;
esac
true
