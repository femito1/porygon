# netv2 run settings (sourced by scripts/slurm_train_v2.sbatch under `set -euo pipefail`; branch on $RUN_NAME;
# keep every command failure-proof and end the file with `true`). Master copy: this file on the cluster.
# Never edit it while a job is inside nv2_pause (INLINE_CMD / HOLD / WAIT_FOR): bash reads a sourced file as it runs.
FORMAT=gen4randombattle
TOTAL=1000000000
CHAIN=0
NV2=${NV2:-/vol/bitbucket/fr1226/porygon-ws-netv2}
V1_46M=/vol/bitbucket/fr1226/gloria/runs/resume/pool/ppo_46259712_steps.pt
G9_P1=$NV2/runs/pretrain/P1-g9h-dmg-s2.pt
# P3 (BC on 7.05M human decisions; P3 vs P1 59.6%): a byte-identical read-only copy of runs/pretrain/g9-p3-s2/final.pt
# (md5 3e600174) under a distinct name (its frozen-pool copy is pool/frozen/P3-g9-s2.pt); G9q's init, anchor and frozen net
G9_P3=$NV2/runs/pretrain/P3-g9-s2.pt
# --eval-async for every lineage from the 04:00 infrastructure restart on (pre-registered in STATUS.md)
NV2_EVAL_ASYNC=1
# Fresh job (2026-11-09 netv2 resubmit fix; laptop mock scripts/netv2_job_mock.sh): slurm_train_v2.sbatch sources this
# file once BEFORE it sets LOCAL, so a requeued or chained job used to skip every lineage step at its first launch (no
# lineage --run-dir / --pool-dir, resume from the mode's default = an old handover or init-g9s.pt, empty pool). In a
# job with LOCAL unset, use the job script's own value (${TMPDIR:-/tmp}/ws-netv2-$SLURM_JOB_ID, set again identically
# later) so the first launch already gets the lineage dirs, the newest mirrored lineage file and a re-seeded pool.
if [ -z "${LOCAL:-}" ] && [ -n "${SLURM_JOB_ID:-}" ]; then
  LOCAL=${TMPDIR:-/tmp}/ws-netv2-$SLURM_JOB_ID
  mkdir -p "$LOCAL/run" "$LOCAL/pool" || true
fi
# NV2_GPU_MIB (2026-11-09 evening, speed only): this job's GPU memory in MiB, read once per job script process; sizes
# the opponent-net cache at the G9p / G9s call sites below (A16 15356, A30 24576, A40 46068, A100 40960 / 81920);
# 0 = unknown (no nvidia-smi, e.g. the laptop mocks, which may preset it) -> the A30 / A16 values.
if [ -z "${NV2_GPU_MIB:-}" ]; then
  NV2_GPU_MIB=$(timeout 20 nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2> /dev/null | head -n 1 | tr -dc 0-9 || true)
  NV2_GPU_MIB=${NV2_GPU_MIB:-0}
fi
# Successor jobs (2026-11-09 19:30, orchestrator-approved; speed only): every job of the r1 / g9 runs other than the
# ones running at 19:30 (718701 G9p, 741849 G9s; R1b-F's g4r1bf branch never switches) runs its trainer through
# $NV2_SUCC_PY, which puts a read-only src copy first on PYTHONPATH and execs gloria's python (same PID, parent and
# command line as before: the deadline watcher and the SIGINT helpers match it); those jobs also get
# --snapshot-cache-cpu (A30 400 nets ~9.4 GiB of 96G host RAM, A16 200 ~4.7 GiB of 64G). The running jobs 741849 and
# 829660 keep $C/src and byte-identical trainer args at a restart in place.
# 2026-11-10 (v5, orchestrator-approved): the wrapper is $NV2/bin/py-src-24c633f = ws/netv2 24c633f (9d0efe0's
# --snapshot-cache-cpu + the stacked-opp fix: frozen nets in their own stack, fused slot fills; same logits), and job
# 718701 (G9p, --stacked-opp) runs it too from its next restart in place, with byte-identical trainer args (no CPU
# tier: its pool stays under --snapshot-cache 192 until its deadline stop).
NV2_SUCC_PY=$NV2/bin/py-src-24c633f
nv2_successor() {
  case ${SLURM_JOB_ID:-} in ""|718701|741849|829660) return 1 ;; esac
  [ -x "$NV2_SUCC_PY" ]
}
nv2_newsrc_718701() { [ "${SLURM_JOB_ID:-}" = 718701 ] && [ -x "$NV2_SUCC_PY" ]; }
# v8 (2026-11-10; actor-stream (b) PASSED, runs/as-test-b/RESULT.txt; adoption reported to the orchestrator first): the
# G9p lineage (job 718701 from its next restart in place, and its successors) trains with overlap + --actor-stream
# --decoupled (in place of --no-overlap) through $NV2/bin/py-src-4f18108 = ws/netv2 4f18108's src (= 24c633f's src +
# the actor-stream patch; read-only copy $NV2/src-4f18108, the (a)/(b) arms' code). Other lineages unchanged.
NV2_AS_PY=$NV2/bin/py-src-4f18108
nv2_actor_stream_g9p() {
  { [ "${SLURM_JOB_ID:-}" = 718701 ] || nv2_successor; } || return 0
  [ -x "$NV2_AS_PY" ] || return 0
  case $TRAIN_ARGS in *" --no-overlap "*) ;; *) return 0 ;; esac
  PY=$NV2_AS_PY
  TRAIN_ARGS="${TRAIN_ARGS/ --no-overlap / --actor-stream --decoupled }"
}
# the deadline watcher's trainer pattern: gloria's python, whatever PY is (a successor's PY is the wrapper above)
NV2_DEADLINE_PAT=${NV2_DEADLINE_PAT:-"^/vol/bitbucket/fr1226/gloria/.venv/bin/python -u -m porygon.v2.train( |\$)"}
# nv2_reseed LIN FILE (a fresh job resuming LIN from the mirrored FILE): copy that mirrored lineage dir's best / ema
# models and pool/frozen nets (now) and its pool snapshots (newest first, in the background; NAME.tmp + mv, mtimes kept;
# the trainer lists *.pt) into $LOCAL/run/LIN, and point $LOCAL/run/final_model.pt at LIN/final_model.pt (symlink) so
# the job script's restart-in-place and chain tests, which look for the top-level file, see the lineage's state.
nv2_reseed() {
  local lin=$1 src=$2 md f b
  md=${src%/final_model.pt}; md=${md%/checkpoints/*}
  if [ ! -d "$md" ]; then return 0; fi
  mkdir -p "$LOCAL/run/$lin/pool/frozen" || true
  for f in best_model.pt ema_model.pt; do
    if [ -f "$md/$f" ] && [ ! -e "$LOCAL/run/$lin/$f" ]; then cp -p "$md/$f" "$LOCAL/run/$lin/$f" || true; fi
  done
  for f in "$md"/pool/frozen/*.pt; do
    if [ ! -f "$f" ]; then continue; fi
    b=${f##*/}
    if [ ! -e "$LOCAL/run/$lin/pool/frozen/$b" ]; then
      { cp -p "$f" "$LOCAL/run/$lin/pool/frozen/$b.tmp" && mv -f "$LOCAL/run/$lin/pool/frozen/$b.tmp" "$LOCAL/run/$lin/pool/frozen/$b"; } || true
    fi
  done
  ( set +e
    for f in $(ls -t "$md"/pool/*.pt 2>/dev/null); do
      b=${f##*/}
      if [ ! -e "$LOCAL/run/$lin/pool/$b" ]; then cp -p "$f" "$LOCAL/run/$lin/pool/$b.tmp" && mv -f "$LOCAL/run/$lin/pool/$b.tmp" "$LOCAL/run/$lin/pool/$b"; fi
    done ) > /dev/null 2>&1 < /dev/null &
  if [ ! -e "$LOCAL/run/final_model.pt" ] && [ ! -L "$LOCAL/run/final_model.pt" ]; then ln -s "$lin/final_model.pt" "$LOCAL/run/final_model.pt" || true; fi
  echo "$(date -u +%T) fresh job: $lin resumes from $src; best/ema + pool/frozen copied from $md, pool copying (newest first)" >> "$LOCAL/run/train.log" || true
  return 0
}
# nv2_deadline_watch (once per job script process): a background watcher stops the trainer gracefully
# NV2_DEADLINE_MARGIN_S (900 s) before the job's end (SLURM_JOB_END_TIME): it removes runs/RUN_NAME/restart and sends
# SIGINT to this job script's trainer child (by parent PID; once per trainer PID, also to a relaunch), so the trainer
# saves after its step, the restart loop ends and the job mirrors and chains with time to spare. At the time limit
# itself Slurm allows KillWait = 30 s before SIGKILL: too short for an A16 step (~85 s) plus the NFS mirror.
nv2_deadline_watch() {
  local bpid=$$ end=${SLURM_JOB_END_TIME:-} margin=${NV2_DEADLINE_MARGIN_S:-900} poll=${NV2_DEADLINE_POLL_S:-60}
  if [ -z "${LOCAL:-}" ] || [ -z "$end" ] || [ -z "${RUN_NAME:-}" ]; then return 0; fi
  case $end in *[!0-9]*) return 0 ;; esac
  if [ -e "$LOCAL/.deadline-watch-$bpid" ]; then return 0; fi
  touch "$LOCAL/.deadline-watch-$bpid" || return 0
  echo "$(date -u +%T) deadline watch armed (job script pid $bpid): graceful stop at $(date -u -d "@$((end - margin))" +%FT%T), job ends $(date -u -d "@$end" +%FT%T)" >> "$LOCAL/run/train.log" || true
  ( set +e
    pat=${NV2_DEADLINE_PAT:-"^${PY:-/vol/bitbucket/fr1226/gloria/.venv/bin/python} -u -m porygon.v2.train( |\$)"}; sent=" "  # PAT: mock only
    while [ "$(date +%s)" -lt "$((end - margin))" ]; do
      if ! kill -0 "$bpid" 2> /dev/null; then exit 0; fi  # the job script is gone: nothing to stop
      sleep "$poll"
    done
    touch "$LOCAL/DEADLINE"; rm -f "$NV2/runs/$RUN_NAME/restart"
    echo "$(date -u +%T) deadline watch: $((margin / 60)) min before the job's end: restart flag removed, stopping the trainer" >> "$LOCAL/run/train.log"
    while kill -0 "$bpid" 2> /dev/null; do
      for p in $(pgrep -P "$bpid" -f "$pat"); do
        case $sent in *" $p "*) continue ;; esac
        if kill -INT "$p"; then sent="$sent$p "; echo "$(date -u +%T) deadline watch: SIGINT $p" >> "$LOCAL/run/train.log"; fi
      done
      sleep 10
    done ) > /dev/null 2>&1 < /dev/null &
  return 0
}
# nv2_followup STATE: sets NV2_FU = the follow-up number to apply at this (re)start ("" = none) and NV2_FU_FIRST=1 on
# the first relaunch into it. A follow-up starts when runs/STATE/FOLLOWUP<n> exists (by hand) or, automatically, when
# the trainer left GUARD_TRIPPED in its run dir (the restart flag is kept armed so the job relaunches in place instead
# of ending): an entropy or pg-mean trip -> 1, any other trip -> 2. The first relaunch records runs/STATE/FU.started.
nv2_followup() {
  local run=$1
  NV2_FU="" NV2_FU_FIRST=""
  if [ -f "$NV2/runs/$run/FU.started" ]; then NV2_FU=$(cut -d' ' -f1 "$NV2/runs/$run/FU.started" || true); return 0; fi
  if [ -f "$NV2/runs/$run/FOLLOWUP2" ]; then NV2_FU=2
  elif [ -f "$NV2/runs/$run/FOLLOWUP1" ]; then NV2_FU=1
  elif [ -n "${LOCAL:-}" ] && [ -f "${NV2_RUNDIR:-$LOCAL/run}/GUARD_TRIPPED" ]; then
    if grep -qE "entropy|pg mean" "${NV2_RUNDIR:-$LOCAL/run}/GUARD_TRIPPED"; then NV2_FU=1; else NV2_FU=2; fi
  fi
  if [ -n "$NV2_FU" ]; then mkdir -p "$NV2/runs/$run" || true; echo "$NV2_FU $(date -u +%FT%T)" > "$NV2/runs/$run/FU.started" || true; NV2_FU_FIRST=1; fi
  return 0
}
# nv2_pause RUN: at a (re)start inside a job (LOCAL set): run runs/RUN/INLINE_CMD once (bash, synchronously, LOCAL
# exported, in this allocation; log runs/RUN/inline-<time>.log), then wait while runs/RUN/HOLD exists (<= 4 h), then
# wait until the path named in runs/RUN/WAIT_FOR exists (<= 2 h; the file is consumed). Mode files read after it see a
# decision taken meanwhile.
nv2_pause() {
  local d=$NV2/runs/$1 t keep w
  [ -n "${LOCAL:-}" ] || return 0
  if [ -f "$d/INLINE_CMD" ]; then
    mv -f "$d/INLINE_CMD" "$d/INLINE_CMD.running" || true
    t=$(date -u +%Y%m%d-%H%M%S)
    echo "$(date -u +%T) inline command (runs/$1/INLINE_CMD.done-$t, log inline-$t.log)" >> "$LOCAL/run/train.log" || true
    ( while sleep 300; do touch "$LOCAL/run/train.log"; done ) & keep=$!  # the job's 45-min silence watchdog
    (cd "$NV2" && export LOCAL && bash "$d/INLINE_CMD.running") > "$d/inline-$t.log" 2>&1 || true
    kill "$keep" 2>/dev/null || true
    mv -f "$d/INLINE_CMD.running" "$d/INLINE_CMD.done-$t" || true
    echo "$(date -u +%T) inline command done" >> "$LOCAL/run/train.log" || true
  fi
  for ((t = 0; t < ${NV2_HOLD_ITERS:-480}; t++)); do
    [ -f "$d/HOLD" ] || break
    if [ "$t" = 0 ]; then echo "$(date -u +%T) HOLD: waiting while $d/HOLD exists (max 4 h)" >> "$LOCAL/run/train.log" || true; fi
    touch "$LOCAL/run/train.log" || true
    sleep 30
  done
  if [ -f "$d/WAIT_FOR" ]; then
    w=$(head -n 1 "$d/WAIT_FOR" || true)
    echo "$(date -u +%T) WAIT_FOR: $w (max 2 h)" >> "$LOCAL/run/train.log" || true
    for ((t = 0; t < ${NV2_WAIT_ITERS:-240}; t++)); do
      if [ -z "$w" ] || [ -e "$w" ]; then break; fi
      touch "$LOCAL/run/train.log" || true
      sleep "${NV2_WAIT_SLEEP:-30}"
    done
    if [ -n "$w" ] && [ -e "$w" ]; then NV2_WAITED_OK=1; else NV2_WAITED_OK=""; fi
    echo "$(date -u +%T) WAIT_FOR done (found: ${NV2_WAITED_OK:-no})" >> "$LOCAL/run/train.log" || true
    mv -f "$d/WAIT_FOR" "$d/WAIT_FOR.done-$(date -u +%H%M%S)" || true
  fi
  return 0
}
# nv2_pool_trip RUN: a "pool:" guard trip (a pool opponent failed to load: infrastructure, not learning) never starts
# a follow-up or fallback: its GUARD_TRIPPED is renamed GUARD_TRIPPED.pool-<time> and runs/RUN/HOLD is created, so the
# job keeps its allocation and waits (<= 4 h, nv2_pause) for the pool to be fixed and HOLD removed; then it relaunches
# the same config (a second trip after that ends the job: the restart flag is consumed).
nv2_pool_trip() {
  local f
  [ -n "${LOCAL:-}" ] || return 0
  for f in "$LOCAL"/run/GUARD_TRIPPED "$LOCAL"/run/*/GUARD_TRIPPED; do
    [ -f "$f" ] || continue
    if grep -q "^pool:" "$f"; then
      mv -f "$f" "$f.pool-$(date -u +%H%M%S)" || true
      touch "$NV2/runs/$1/HOLD" || true
      echo "$(date -u +%T) pool guard trip ($f): HOLD — fix the pool, then rm runs/$1/HOLD" >> "$LOCAL/run/train.log" || true
    fi
  done
  return 0
}
# nv2_second_trip RUN LIN STATE (05:35, never release an allocation: orchestrator 04:50): a guard trip of lineage
# LIN after its once-only fallback already ran (runs/STATE/FU.started) holds the allocation instead of ending the job
# or relaunching into the same trip: its GUARD_TRIPPED is renamed GUARD_TRIPPED.second-<time> and runs/RUN/HOLD is
# created (<= 4 h, nv2_pause) for a decision; after the hold the same config continues from the trip state. (The
# first trip's file is renamed GUARD_TRIPPED.fu-<time> when its fallback starts, so it never counts twice.)
nv2_second_trip() {
  local run=$1 lin=$2 state=$3 f
  [ -n "${LOCAL:-}" ] || return 0
  f=$LOCAL/run/$lin/GUARD_TRIPPED
  if [ -f "$f" ] && [ -f "$NV2/runs/$state/FU.started" ]; then
    mv -f "$f" "$f.second-$(date -u +%H%M%S)" || true
    touch "$NV2/runs/$run/HOLD" || true
    echo "$(date -u +%T) second guard trip of $lin after its fallback: HOLD — decide, then rm runs/$run/HOLD" >> "$LOCAL/run/train.log" || true
  fi
  return 0
}
# v9 (2026-11-10): the G9q <-> G9p GPU swap (G9q -> the A30 = r1 MODE g9q, G9p -> the A16 = g9 MODE g9p2), two-phase
# and all-or-nothing (orchestrator's hard condition; kit + recovery: runs/swap-50M/PROCEDURE.txt). Phase 1 = each
# job's INLINE_CMD (nv2_pause, trainer stopped): its lineage's just-saved state -> its handover dir, published whole
# (NAME.tmp + mv) with a DONE file (718701: G9p -> runs/r1/handover-g9p-a16/, 741849: G9q -> runs/g9q/handover-a30/),
# or runs/swap-50M/FAIL-<run> (and nothing else) if anything failed. Phase 2 = nv2_swap RUN below, at every (re)start
# of r1 / g9 (after nv2_pause): while runs/swap-50M/DECISION is absent, a side whose handover is DONE (or that sees a
# FAIL) waits (<= 2 h, train.log fed) for the other side's DONE / a FAIL / a decision, then writes the ONE decision
# atomically (hard link: the first writer wins and both sides act on its content): COMMIT iff both handovers are DONE
# and no FAIL exists, else ABORT. COMMIT, applied once per run (runs/RUN/SWAP_APPLIED): MODE r1 g9p -> g9q, g9 g9q ->
# g9p2. ABORT: nothing changes; each job resumes its own lineage from its own local save. A fresh job applies a COMMIT
# its predecessor never applied, and a side that published DONE but died before a decision is decided by its next
# start, so neither lineage is ever trained twice or dropped. The new modes also refuse a first start unless the
# DECISION is COMMIT and the handover they start from is DONE (else the job's previous lineage continues). Progress:
# runs/swap-50M/STATE (one line per phase per side). Do not edit this file while a job waits in nv2_swap either.
NV2_SWAP=$NV2/runs/swap-50M
nv2_swap_decision() { head -n 1 "$NV2_SWAP/DECISION" 2>/dev/null | cut -d' ' -f1 || true; }
nv2_swap_ready() { [ -f "$1/DONE" ] && [ -f "$1/final_model.pt" ] && [ "$(nv2_swap_decision)" = COMMIT ]; }
nv2_swap_decide() {  # nv2_swap_decide COMMIT|ABORT RUN: propose; the existing DECISION (if any) wins
  local v=$1 run=$2 tmp=$NV2_SWAP/.decision-$2-$$ k
  for k in 1 2 3; do
    if [ -f "$NV2_SWAP/DECISION" ]; then break; fi
    { echo "$v by $run ${SLURM_JOB_ID:-} $(date -u +%FT%T)" > "$tmp" && ln "$tmp" "$NV2_SWAP/DECISION"; } 2> /dev/null || true
    rm -f "$tmp" || true
    if [ ! -f "$NV2_SWAP/DECISION" ]; then sleep 2 || true; fi
  done
  echo "$(date -u +%FT%T) $run ${SLURM_JOB_ID:-} phase2 proposed $v; DECISION = $(head -n 1 "$NV2_SWAP/DECISION" 2>/dev/null || echo 'none (could not be written)')" >> "$NV2_SWAP/STATE" || true
  if [ -n "${LOCAL:-}" ]; then echo "$(date -u +%T) swap phase 2: proposed $v; DECISION = $(head -n 1 "$NV2_SWAP/DECISION" 2>/dev/null || echo none)" >> "$LOCAL/run/train.log" || true; fi
  return 0
}
nv2_swap() {
  local run=$1 mine other lin pre post t d m
  case $run in
    r1) mine=$NV2/runs/r1/handover-g9p-a16; other=$NV2/runs/g9q/handover-a30; lin=G9p; pre=g9p; post=g9q ;;
    g9) mine=$NV2/runs/g9q/handover-a30; other=$NV2/runs/r1/handover-g9p-a16; lin=G9q; pre=g9q; post=g9p2 ;;
    *) return 0 ;;
  esac
  [ -d "$NV2_SWAP" ] || return 0
  if [ ! -f "$NV2_SWAP/DECISION" ] && { [ -f "$mine/DONE" ] || ls "$NV2_SWAP"/FAIL-* > /dev/null 2>&1; }; then
    if [ -n "${LOCAL:-}" ]; then echo "$(date -u +%T) swap phase 2: waiting for $other/DONE (max 2 h)" >> "$LOCAL/run/train.log" || true; fi
    for ((t = 0; t < ${NV2_SWAP_ITERS:-240}; t++)); do
      if [ -f "$NV2_SWAP/DECISION" ] || [ -f "$other/DONE" ] || ls "$NV2_SWAP"/FAIL-* > /dev/null 2>&1; then break; fi
      if [ -n "${LOCAL:-}" ]; then touch "$LOCAL/run/train.log" || true; fi  # the job's 45-min silence watchdog
      sleep "${NV2_SWAP_SLEEP:-30}" || true
    done
    if [ -f "$mine/DONE" ] && [ -f "$other/DONE" ] && ! ls "$NV2_SWAP"/FAIL-* > /dev/null 2>&1; then nv2_swap_decide COMMIT "$run"; else nv2_swap_decide ABORT "$run"; fi
  fi
  d=$(nv2_swap_decision)
  if [ "$d" = COMMIT ] && [ ! -f "$NV2/runs/$run/SWAP_APPLIED" ]; then
    m=$(cat "$NV2/runs/$run/MODE" 2>/dev/null || true)
    if [ "$m" = "$pre" ]; then echo "$post" > "$NV2/runs/$run/MODE" || true; fi
    date -u +%FT%T > "$NV2/runs/$run/SWAP_APPLIED" || true
    # the handed-over lineage's trip file travelled with the handover: never act on it here as well
    if [ -n "${LOCAL:-}" ] && [ -f "$LOCAL/run/$lin/GUARD_TRIPPED" ]; then mv -f "$LOCAL/run/$lin/GUARD_TRIPPED" "$LOCAL/run/$lin/GUARD_TRIPPED.handed-over-$(date -u +%H%M%S)" || true; fi
    echo "$(date -u +%FT%T) $run ${SLURM_JOB_ID:-} phase2 applied COMMIT: MODE $m -> $(cat "$NV2/runs/$run/MODE" 2>/dev/null || true)" >> "$NV2_SWAP/STATE" || true
    if [ -n "${LOCAL:-}" ]; then echo "$(date -u +%T) swap COMMIT applied: runs/$run/MODE $m -> $(cat "$NV2/runs/$run/MODE" 2>/dev/null || true)" >> "$LOCAL/run/train.log" || true; fi
  fi
  return 0
}
# nv2_g9_args STATE BASE: TRAIN_ARGS for a G9 lineage from its base args and the guard-fallback state in
# runs/STATE/ (pre-registered in STATUS.md, once per lineage): a collapse trip (entropy / P(top) guards) continues
# from the trip state with the KL-anchor coefficient x3 (0.1 -> 0.3); any other trip restarts from best_model.pt with
# the lr halved. The trip reason is kept in runs/STATE/FU.reason.
nv2_g9_args() {
  local state=$1 base=$2
  TRAIN_ARGS=$base
  nv2_followup "$state"
  [ -n "$NV2_FU" ] || return 0
  if [ -n "$NV2_FU_FIRST" ] && [ -n "${LOCAL:-}" ]; then
    cp -f "${NV2_RUNDIR:-$LOCAL/run}/GUARD_TRIPPED" "$NV2/runs/$state/FU.reason" 2>/dev/null || true
    mv -f "${NV2_RUNDIR:-$LOCAL/run}/GUARD_TRIPPED" "${NV2_RUNDIR:-$LOCAL/run}/GUARD_TRIPPED.fu-$(date -u +%H%M%S)" 2>/dev/null || true
  fi
  if grep -q collapse "$NV2/runs/$state/FU.reason" 2>/dev/null; then
    TRAIN_ARGS="${base/--kl-anchor-coef 0.1/--kl-anchor-coef 0.3}"
  else
    TRAIN_ARGS="${base/--lr 7e-5/--lr 3.5e-5}"
    if [ -n "$NV2_FU_FIRST" ] && [ -n "${LOCAL:-}" ] && [ -f "${NV2_RUNDIR:-$LOCAL/run}/best_model.pt" ]; then
      cp -f "${NV2_RUNDIR:-$LOCAL/run}/best_model.pt" "$NV2/runs/$state/fu-start-best.pt" || true
      TRAIN_ARGS="$TRAIN_ARGS --resume $NV2/runs/$state/fu-start-best.pt"
    fi
  fi
  return 0
}
# nv2_park_snapshots RUN AFTER LOCALPOOL: move pool snapshots newer than step AFTER (the job's local pool LOCALPOOL and
# runs/RUN/pool) to runs/RUN/pool-before-FU/, so a follow-up from an earlier checkpoint does not play the abandoned
# segment's nets
nv2_park_snapshots() {
  local run=$1 after=$2 lpool=$3 d f n
  mkdir -p "$NV2/runs/$run/pool-before-FU" || true
  for d in "$lpool" "$NV2/runs/$run/pool"; do
    [ -n "$d" ] && [ -d "$d" ] || continue
    for f in "$d"/*.pt; do
      [ -e "$f" ] || continue
      n=$(basename "$f" .pt)
      case $n in *[!0-9]*|"") continue ;; esac
      if [ "$((10#$n))" -gt "$after" ]; then mv -f "$f" "$NV2/runs/$run/pool-before-FU/" || true; fi
    done
  done
}
# nv2_cfg_r1b LOCALPOOL EXTRA: the R1b lineage (gen4; state runs/r1/), wherever it runs. Follow-ups (pre-registered,
# both from the 7.5M checkpoint, one change each): 1 = --ent-coef 0 --zero-avoid-coef 0; 2 = anti-cycling (~1/2 of
# games vs frozen nets). The pg-mean guard is R1b-only.
nv2_cfg_r1b() {
  local lpool=$1 extra=$2 base best=$NV2/runs/r1/restart-best-7.5M.pt
  FORMAT=gen4randombattle; ANCHOR=$V1_46M
  base="--no-bf16 --n-epochs 3 --batch-size 4096 --n-layers 4 --ffn-mult 1 --lr 7e-5 --guard-anchor-drop 0.15 --guard-entropy-max 1.0${NV2_EVAL_ASYNC:+ --eval-async} $extra"
  TRAIN_ARGS="$base --guard-pg-mean 20"
  nv2_followup r1
  case $NV2_FU in
    1) TRAIN_ARGS="$base --ent-coef 0 --zero-avoid-coef 0" ;;
    2) TRAIN_ARGS="$base --n-battles 40 --pool-battles 50 --frozen $best --frozen-best --p-frozen 0.8 --p-baseline 0.1" ;;
  esac
  if [ -n "$NV2_FU" ] && [ -n "$NV2_FU_FIRST" ]; then
    TRAIN_ARGS="$TRAIN_ARGS --resume $best"
    nv2_park_snapshots r1 7500005 "$lpool"
  fi
  return 0
}
# nv2_cfg_g9 WORKERS STATE EXTRA [BC]: the G9 lineage (gen9, fastenv on WORKERS workers, on-policy; guard fallback state
# runs/STATE/). --decoupled dropped at the 03:15 move (redundant with --no-overlap: a pure speed change, STATUS.md).
# BC (2026-11-10, G9q): the BC net in the KL-anchor and frozen roles (default P1 = G9p's recipe, unchanged).
nv2_cfg_g9() {
  local workers=$1 state=$2 extra=$3 bc=${4:-$G9_P1}
  FORMAT=gen9randombattle; ANCHOR=$G9_P1
  mkdir -p "$NV2/runs/$state" || true
  nv2_g9_args "$state" "--no-bf16 --n-epochs 3 --batch-size 4096 --lr 7e-5${NV2_EVAL_ASYNC:+ --eval-async} --guard-anchor-drop 0.15 --guard-entropy-rel 1.5 --guard-entropy-min 0.5 --guard-ptop-max 0.6 --kl-anchor $bc --kl-anchor-coef 0.1 --kl-anchor-decay-steps 50000000 --critic-warmup-steps 1000000 --frozen $bc --p-frozen 0.67 --p-baseline 0.08 --frozen-best --collector fastenv --fastenv-workers $workers --fastenv-battles 48 --no-overlap $extra"
  return 0
}
# nv2_cfg_g9s WORKERS EXTRA: G9s = the gen9 main run from scratch (orchestrator 04:50; pre-registered in STATUS.md
# 04:58): G9's recipe without the P1 init, the KL anchor and the critic warm-up; P1 stays a frozen pool opponent and
# the eval anchor. Guard fallback (state runs/g9s/, once): any non-pool trip -> its best_model.pt at lr 3.5e-5.
# Call after nv2_lineage_dirs G9s (NV2_RUNDIR).
nv2_cfg_g9s() {
  local workers=$1 extra=$2 base
  FORMAT=gen9randombattle; ANCHOR=$G9_P1
  mkdir -p "$NV2/runs/g9s" || true
  # 05:46 guard recalibration for a from-scratch run (orchestrator 05:45, STATUS.md): entropy floor 0.5 -> 0.3
  # 07:01 (pre-registered, STATUS.md; orchestrator heads-up: pg > 0, evals flattening): anchor drop 0.15 -> 0.10
  base="--no-bf16 --n-epochs 3 --batch-size 4096 --lr 7e-5${NV2_EVAL_ASYNC:+ --eval-async} --guard-anchor-drop 0.10 --guard-entropy-rel 1.5 --guard-entropy-min 0.3 --guard-ptop-max 0.6 --frozen $G9_P1 --p-frozen 0.67 --p-baseline 0.08 --frozen-best --collector fastenv --fastenv-workers $workers --fastenv-battles 48 --no-overlap $extra"
  TRAIN_ARGS=$base
  nv2_followup g9s
  [ -n "$NV2_FU" ] || return 0
  if [ -n "$NV2_FU_FIRST" ] && [ -n "${LOCAL:-}" ]; then
    cp -f "${NV2_RUNDIR:-$LOCAL/run}/GUARD_TRIPPED" "$NV2/runs/g9s/FU.reason" 2>/dev/null || true
    mv -f "${NV2_RUNDIR:-$LOCAL/run}/GUARD_TRIPPED" "${NV2_RUNDIR:-$LOCAL/run}/GUARD_TRIPPED.fu-$(date -u +%H%M%S)" 2>/dev/null || true
  fi
  TRAIN_ARGS="${base/--lr 7e-5/--lr 3.5e-5}"
  if [ -n "$NV2_FU_FIRST" ] && [ -n "${LOCAL:-}" ] && [ -f "${NV2_RUNDIR:-$LOCAL/run}/best_model.pt" ]; then
    cp -f "${NV2_RUNDIR:-$LOCAL/run}/best_model.pt" "$NV2/runs/g9s/fu-start-best.pt" || true
    TRAIN_ARGS="$TRAIN_ARGS --resume $NV2/runs/g9s/fu-start-best.pt"
  fi
  return 0
}
# nv2_lineage_dirs LIN OLDPOOL (applied from the first restart after 03:45): the lineage's own run and pool dirs
# inside the job's mirrored run dir ($LOCAL/run/LIN/, pool $LOCAL/run/LIN/pool; OLDPOOL is moved there once), so a
# job that changes lineage never mixes files. Resume: the lineage's own final_model.pt (restart in place), else the
# job's top-level final_model.pt (the switch: it is this lineage's state), else — a fresh job after a requeue — the
# newest mirrored lineage file under runs/*/*/LIN/. A toucher keeps the job's 45-min watchdog (which watches
# $LOCAL/run/train.log) fed only while the lineage's own train.log is fresh.
nv2_lineage_dirs() {
  local lin=$1 oldpool=$2 r=""
  NV2_LIN_ARGS="" NV2_LIN_RESUME=""
  [ -n "${LOCAL:-}" ] || return 0
  mkdir -p "$LOCAL/run/$lin" || true
  if [ ! -d "$LOCAL/run/$lin/pool" ] && [ -n "$oldpool" ] && [ -d "$oldpool" ]; then mv "$oldpool" "$LOCAL/run/$lin/pool" || true; fi
  mkdir -p "$LOCAL/run/$lin/pool" || true
  if [ -f "$LOCAL/run/$lin/final_model.pt" ]; then r=$LOCAL/run/$lin/final_model.pt
  elif [ ! -f "$LOCAL/run/final_model.pt" ]; then
    r=$(ls -t "$NV2"/runs/*/*/"$lin"/checkpoints/*.pt "$NV2"/runs/*/*/"$lin"/final_model.pt 2>/dev/null | head -n 1 || true)
    if [ -n "$r" ]; then nv2_reseed "$lin" "$r"; fi
  fi
  NV2_LIN_ARGS="--run-dir $LOCAL/run/$lin --pool-dir $LOCAL/run/$lin/pool"; NV2_LIN_RESUME=$r
  NV2_RUNDIR=$LOCAL/run/$lin  # where this lineage's trainer leaves GUARD_TRIPPED / best_model.pt
  if [ ! -f "$LOCAL/.toucher-$lin" ]; then
    ( while sleep 300; do
        f=$LOCAL/run/$lin/train.log
        if [ -f "$f" ] && [ $(( $(date +%s) - $(stat -c %Y "$f") )) -lt 2400 ]; then touch "$LOCAL/run/train.log"; fi
      done ) &
    touch "$LOCAL/.toucher-$lin" || true
  fi
  return 0
}
# v10 (2026-11-11; G9r, approved .orchestra/netv2/G9R-PROPOSAL.md 3(b) / 4 / 6): g9 MODE g9r = this A16 (741849 and
# its successor 810367 on an a16 / a40 / a100) trains G9r = G9q's recipe with ONE change, the lr shape: --lr-schedule
# power --lr-horizon 300000000 (7e-5 x (8x+1)^-1.5 over absolute lineage steps after the 1M warm-up, flat at /27 from
# 300M; ws/netv2 ff32b71), plus the pre-registered guard exception: entropy floor 0.35 (replaces 0.5; ptop 0.6 kept).
# P3 = init (steps 0, fresh AdamW), KL anchor (0.1 -> 0 at 50M) and frozen net (+ --frozen-best); eval anchor P1;
# November sets for the collector (PORYGON_PS, as G9q). Lineage dir $LOCAL/run/G9r (mirrored as runs/g9/<job>/G9r),
# guard / fallback state runs/g9r/ (G9q's rules, once: collapse -> KL x3; any other trip -> best_model.pt with --lr
# 3.5e-5 = the whole power curve halved; a trip after that -> HOLD). First start (runs/g9r/G9R_STARTED absent) from
# P3; then its own final_model.pt (restart in place), else its newest checkpoint (local or mirrored), else (a fresh job)
# its newest mirrored G9r file; never a parked lineage (runs/*-parked/ are not lineage mirrors). The trainer runs
# through $NV2/bin/py-src-ff32b71 (read-only $NV2/src-ff32b71 = ff32b71's src: 24c633f + the opt-in actor stream, off
# here, + the lr schedule) in every job (no wrapper: HOLD <= 4 h, the default src has no --lr-schedule); speed only:
# G9q's successor settings: cache 72 + --snapshot-cache-cpu 200 on the A16, 512 + --stacked-opp + cpu 200 on >= 40 GB.
# MODE g9r is written only by the park INLINE_CMD (scripts/netv2_g9r/inline-a16-park-g9r.sh) after the A16's lineage
# (G9q under MODE g9q, G9p under g9p2) is parked whole; nv2_swap flips only g9q -> g9p2, so a swap COMMIT applied
# later (a fresh job, SWAP_APPLIED absent) leaves MODE g9r and G9r running. r1 / g4r1bf and the other g9 modes: unchanged.
NV2_G9R_PY=$NV2/bin/py-src-ff32b71
# v12 (DRAFT, not deployed; .orchestra/netv2/NEXT-RECIPE-PROPOSAL.md 3 / 5 + its ORCHESTRATOR DECISIONS): MODE g9t (g9
# = the A16, r1 = the A30) trains G9t = control C's recipe with ONE change, --gae-lambda LAMBDA (the advantage AND the
# critic's target). C and LAMBDA come from runs/g9t/RECIPE: exactly one line other than blank / # lines, "C LAMBDA",
# C in {g9q, g9r} (g9q = G9q's recipe: wsd, constant lr 7e-5, entropy floor 0.5; g9r = G9r's: --lr-schedule power
# --lr-horizon 300000000, floor 0.35), LAMBDA in {0.5, 0.6}. The first start records "TIME C LAMBDA RUN JOB" in
# runs/g9t/G9T_STARTED; every later start takes the recipe from that record (a later RECIPE edit is ignored, with a
# note) and runs G9t only in that RUN (never two G9t trainers). Refused (train.log note; this run's current lineage
# continues: g9 -> G9r, r1 -> G9q): no RECIPE, a malformed one (and no record), an unreadable record, or G9t started in
# the other run. Init P3 (steps 0, fresh AdamW) at the first start; then its own final_model.pt (restart in place),
# else its newest checkpoint (local or mirrored), else (a fresh job) its newest mirrored G9t file; never a parked dir
# or another lineage's file. Guard / fallback state runs/g9t/ (C's rules, once: collapse -> KL x3; any other trip ->
# best_model.pt at --lr 3.5e-5; a trip after that -> HOLD). November sets for the collector (PORYGON_PS). PY =
# $NV2_G9R_PY (src-ff32b71; its default wsd path is bit-identical) in every job for both C (one src for the whole
# lineage; no wrapper -> HOLD). Speed only, per GPU: A16 8 workers, cache 72 (512 + --stacked-opp on >= 40 GB) + cpu
# 200 (= G9r's); A30 28 workers, 192 (640 on >= 40 GB) + --stacked-opp + cpu 400 (= G9q's A30 successor settings).
# MODE g9t is written only by hand or by a park INLINE_CMD (scripts/netv2_g9r/inline-a16-park-g9r.sh adapted) after
# the run's lineage is parked whole; nv2_swap never flips g9t. Every other mode: unchanged.
NV2_G9T=$NV2/runs/g9t
nv2_g9t_parse() {  # nv2_g9t_parse "C LAMBDA": sets NV2_G9T_C / NV2_G9T_LAM if valid, else returns 1
  local c="" l="" x=""
  read -r c l x <<< "$1" || true
  case "$c $l" in "g9q 0.5"|"g9q 0.6"|"g9r 0.5"|"g9r 0.6") ;; *) return 1 ;; esac
  [ -z "$x" ] || return 1
  NV2_G9T_C=$c NV2_G9T_LAM=$l
  return 0
}
# nv2_g9t_recipe RUN FALLBACK: 0 = G9t trains in RUN (NV2_G9T_C / NV2_G9T_LAM set); 1 = refused (note: FALLBACK continues)
nv2_g9t_recipe() {
  local run=$1 fb=$2 n="" line="" rec="" why="" t="" c="" l="" r="" x=""
  NV2_G9T_C="" NV2_G9T_LAM=""
  if [ -f "$NV2_G9T/RECIPE" ]; then
    n=$(grep -cvE '^[[:space:]]*(#|$)' "$NV2_G9T/RECIPE" 2> /dev/null || true)
    line=$(grep -vE '^[[:space:]]*(#|$)' "$NV2_G9T/RECIPE" 2> /dev/null | head -n 1 | tr -d '\r' || true)
    if [ "$n" = 1 ] && nv2_g9t_parse "$line"; then rec="$NV2_G9T_C $NV2_G9T_LAM"
    else why="runs/g9t/RECIPE malformed (want one line 'g9q|g9r 0.5|0.6'; $n line(s), first: '$(printf '%s' "$line" | head -c 80)')"; fi
  else why="no runs/g9t/RECIPE"; fi
  if [ -f "$NV2_G9T/G9T_STARTED" ]; then
    read -r t c l r x < "$NV2_G9T/G9T_STARTED" || true
    if ! nv2_g9t_parse "$c $l" || [ -z "$r" ]; then why="runs/g9t/G9T_STARTED unreadable ('$(head -c 80 "$NV2_G9T/G9T_STARTED" 2> /dev/null || true)')"
    elif [ "$r" != "$run" ]; then why="G9t started in run $r ($t), not $run"
    else
      if [ -n "$rec" ] && [ "$rec" != "$c $l" ] && [ -n "${LOCAL:-}" ]; then echo "$(date -u +%T) G9t: runs/g9t/RECIPE now says '$rec': ignored, G9t keeps its started recipe '$c $l'" >> "$LOCAL/run/train.log" || true; fi
      return 0
    fi
    NV2_G9T_C="" NV2_G9T_LAM=""
  elif [ -n "$rec" ]; then return 0; fi
  if [ -n "${LOCAL:-}" ]; then echo "$(date -u +%T) MODE g9t refused: $why: $fb continues" >> "$LOCAL/run/train.log" || true; fi
  return 1
}
# nv2_cfg_g9t RUN WORKERS OPP: TRAIN_ARGS / PY for G9t (after nv2_g9t_recipe RUN returned 0)
nv2_cfg_g9t() {
  local run=$1 workers=$2 opp=$3 cx="" floor=0.5 first=""
  mkdir -p "$NV2_G9T" || true
  if [ ! -x "$NV2_G9R_PY" ] && [ -n "${LOCAL:-}" ]; then
    touch "$NV2/runs/$run/HOLD" || true
    echo "$(date -u +%T) MODE g9t but no $NV2_G9R_PY (G9t's src): HOLD — install it, then rm runs/$run/HOLD" >> "$LOCAL/run/train.log" || true
    nv2_pause "$run"
  fi
  if [ "$NV2_G9T_C" = g9r ]; then cx=" --lr-schedule power --lr-horizon 300000000"; floor=0.35; fi
  if [ -n "${LOCAL:-}" ] && [ ! -f "$NV2_G9T/G9T_STARTED" ]; then
    first=1
    mkdir -p "$LOCAL/run/G9t/pool" || true
    echo "$(date -u +%FT%T) $NV2_G9T_C $NV2_G9T_LAM $run ${SLURM_JOB_ID:-}" > "$NV2_G9T/G9T_STARTED" || true
    echo "$(date -u +%T) G9t first start in run $run: from P3 $G9_P3 (steps 0); C = $NV2_G9T_C's recipe (${cx:+lr schedule power H=300000000, }entropy floor $floor) + --gae-lambda $NV2_G9T_LAM (runs/g9t/RECIPE); November sets for the collector (PORYGON_PS=${PORYGON_PS:-})" >> "$LOCAL/run/train.log" || true
  fi
  nv2_lineage_dirs G9t ""
  if [ -n "$first" ]; then NV2_LIN_RESUME=$G9_P3  # first start: the BC init (never the job's top-level file)
  elif [ -z "$NV2_LIN_RESUME" ] && [ -n "${LOCAL:-}" ]; then
    # no G9t final_model.pt in this job (the job's top-level file skips nv2_lineage_dirs' mirror search): G9t's
    # newest checkpoint, local or mirrored; none at all = it never saved (a crash before its first save)
    NV2_LIN_RESUME=$(ls -t "$LOCAL"/run/G9t/checkpoints/*.pt "$NV2"/runs/*/*/G9t/checkpoints/*.pt "$NV2"/runs/*/*/G9t/final_model.pt 2> /dev/null | head -n 1 || true)
    echo "$(date -u +%T) G9t: no final_model.pt of its own here: resuming ${NV2_LIN_RESUME:-P3 again (no G9t save anywhere)}" >> "$LOCAL/run/train.log" || true
  fi
  PY=$NV2_G9R_PY
  nv2_cfg_g9 "$workers" g9t "--n-battles 16 --pool-battles 16 $NV2_LIN_ARGS $opp$cx --gae-lambda $NV2_G9T_LAM" "$G9_P3"
  if [ "$floor" != 0.5 ]; then
    case $TRAIN_ARGS in
      *" --guard-entropy-min 0.5 "*) TRAIN_ARGS="${TRAIN_ARGS/ --guard-entropy-min 0.5 / --guard-entropy-min $floor }" ;;
      *) TRAIN_ARGS="$TRAIN_ARGS --guard-entropy-min $floor" ;;  # (argparse: the last one wins)
    esac
  fi
  case $TRAIN_ARGS in *--resume*) ;; *) TRAIN_ARGS="$TRAIN_ARGS --resume ${NV2_LIN_RESUME:-$G9_P3}" ;; esac
  return 0
}
# v15 (2026-11-15, USER decision ~14:05; runs/g9q2/PREREG.txt): g9 MODE g9q2 = this A16 trains G9q2 = G9q's recipe
# (the MODE g9q branch: P3 init / KL anchor 0.1 -> 0 at 50M / frozen + --frozen-best, wsd lr 7e-5, entropy floor 0.5,
# G9q's guard fallback rules with their own state runs/g9q2/) with ONLY the seed changed: its FIRST start (runs/g9q2/
# G9Q2_STARTED absent; from P3, steps 0) adds --seed $NV2_G9Q2_SEED; every later start runs without --seed, exactly as
