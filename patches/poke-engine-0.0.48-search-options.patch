+
+// draw an option from regret matching's strategy mixed with `gamma` uniform; returns (index, its probability)
+fn regret_matching_draw(options: &mut [MoveNode], gamma: f32, rng: &mut impl Rng) -> (usize, f32) {
+    let n = options.len() as f32;
+    let positive: f32 = options.iter().map(|o| o.regret.max(0.0)).sum();
+    let mut threshold = rng.random_range(0.0..1.0f32);
+    let mut chosen: Option<(usize, f32)> = None;
+    let mut last = (0, 0.0);
+    for (i, o) in options.iter_mut().enumerate() {
+        let sigma = if positive > 0.0 { o.regret.max(0.0) / positive } else { 1.0 / n };
+        o.strategy_sum += sigma;
+        let p = (1.0 - gamma) * sigma + gamma / n;
+        last = (i, p);
+        if chosen.is_none() {
+            threshold -= p;
+            if threshold <= 0.0 {
+                chosen = Some((i, p));
+            }
+        }
+    }
+    chosen.unwrap_or(last) // float rounding
+}
+
+fn regret_update(options: &mut [MoveNode], chosen: usize, score: f32, prob: f32) {
+    for o in options.iter_mut() {
+        o.regret -= score;
+    }
+    options[chosen].regret += score / prob.max(1e-6);
 }
 
