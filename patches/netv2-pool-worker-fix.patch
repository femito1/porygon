+    def _pool_alarm(self, eps: list[dict], st: dict) -> None:
+        """Pool share of the rollout's finished episodes; fail loudly when pool battles are configured but none
+        finished for --pool-alarm-updates updates in a row (a hung or misrouted pool must not train silently)."""
+        n_pool = sum(e["kind"] == "pool" for e in eps)
+        st["perf/pool_episode_share"] = n_pool / max(len(eps), 1)
+        expected = self.args.pool_battles > 0 and getattr(self.workers, "pool_per_worker", 1) != 0
+        if not expected or self.args.pool_alarm_updates <= 0:
+            return
+        self.pool_dry = 0 if n_pool else getattr(self, "pool_dry", 0) + 1
+        if self.pool_dry >= self.args.pool_alarm_updates:
+            msg = (f"POOL ALARM: {self.args.pool_battles} pool battles configured but no pool episode finished in "
+                   f"{self.pool_dry} updates in a row (worker restarts {self.workers.restarts}); stopping")
+            self.log(msg)
+            (self.run_dir / "POOL_ALARM").write_text(msg + "\n")
+            raise RuntimeError(msg)
+
