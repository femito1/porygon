+def monte_carlo_tree_search_priors(
+    state: State, priors: dict, c_puct: float, duration_ms: int = 1000, iterations: int = 0
+) -> MctsResult:
+    """
+    Single-threaded MCTS where side one's root options are chosen by PUCT on `priors`
+    (engine choice string, as in MctsSideResult.move_choice -> prior; missing options get 0)
+    """
+    return MctsResult._from_rust(mcts_priors(state, duration_ms, iterations, priors, c_puct))
+
+
+def monte_carlo_tree_search_joint(
+    state: State, duration_ms: int = 1000, iterations: int = 0, priors: dict | None = None, c_puct: float = 0.0
+) -> tuple:
+    """
+    Single-threaded MCTS (optionally PUCT at side one's root, as monte_carlo_tree_search_priors), plus the
+    root's joint statistics: (MctsResult, [(side one choice, side two choice, visits, side one's total score)])
+    """
+    result, joint = mcts_joint(state, duration_ms, iterations, priors or {}, c_puct)
+    return MctsResult._from_rust(result), joint
+
