+// side one's root options chosen by PUCT on `priors` (engine choice string -> prior, missing = 0)
+#[pyfunction]
+fn mcts_priors(
+    py_state: PyState,
+    duration_ms: u64,
+    mut iterations: u32,
+    priors: HashMap<String, f32>,
+    c_puct: f32,
+) -> PyResult<PyMctsResult> {
+    let mut state: State = py_state.into();
+    let duration = Duration::from_millis(duration_ms);
+    let (s1_options, s2_options) = state.root_get_all_options();
+    if s1_options.len() <= 1 {
+        iterations = 100; // if there's only one option, force a quick exit
+    }
+    let s1_priors: Vec<f32> = s1_options
+        .iter()
+        .map(|o| *priors.get(&movechoice_to_string(&state.side_one, o)).unwrap_or(&0.0))
+        .collect();
+    let mcts_result = perform_mcts_with_priors(
+        &mut state, s1_options, s2_options, duration, iterations, &s1_priors, c_puct,
+    );
+    Ok(PyMctsResult::from_mcts_result(mcts_result, &state))
+}
+
+// as mcts_priors, plus the root's joint statistics: [(s1 choice, s2 choice, visits, s1 total score)]
+#[pyfunction]
+fn mcts_joint(
+    py_state: PyState,
+    duration_ms: u64,
+    mut iterations: u32,
+    priors: HashMap<String, f32>,
+    c_puct: f32,
+) -> PyResult<(PyMctsResult, Vec<(String, String, u32, f32)>)> {
+    let mut state: State = py_state.into();
+    let duration = Duration::from_millis(duration_ms);
+    let (s1_options, s2_options) = state.root_get_all_options();
+    if s1_options.len() <= 1 {
+        iterations = 100; // if there's only one option, force a quick exit
+    }
+    let s1_priors: Vec<f32> = s1_options
+        .iter()
+        .map(|o| *priors.get(&movechoice_to_string(&state.side_one, o)).unwrap_or(&0.0))
+        .collect();
+    let mut joint = Vec::new();
+    let mcts_result = perform_mcts_joint(
+        &mut state, s1_options.clone(), s2_options.clone(), duration, iterations, &s1_priors, c_puct,
+        Some(&mut joint),
+    );
+    let pairs = joint
+        .into_iter()
+        .map(|(i, j, n, score)| {
+            (
+                movechoice_to_string(&state.side_one, &s1_options[i]),
+                movechoice_to_string(&state.side_two, &s2_options[j]),
+                n,
+                score,
+            )
+        })
+        .collect();
+    Ok((PyMctsResult::from_mcts_result(mcts_result, &state), pairs))
+}
