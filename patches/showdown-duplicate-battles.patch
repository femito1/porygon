+/**
+ * Porygon duplicate battles (benchmarking only, off unless PORYGON_DUPLICATE is set): battles come in pairs
+ * with the same two team seeds and the same battle seed, the teams swapped in the second game, so team luck
+ * cancels out when a pair is scored together. The player whose name matches PORYGON_DUPLICATE_GROUP (default:
+ * p1) gets team A in the first game of a pair and team B in the second. Every finished battle is appended to
+ * PORYGON_DUPLICATE_LOG (JSON lines: pair, game, players, winner, both true teams).
+ */
+let porygonBattles = 0;
+function porygonDuplicate(names: string[]) {
+	const base = process.env.PORYGON_DUPLICATE;
+	if (!base) return null;
+	const k = porygonBattles++;
+	const pair = k >> 1, second = k & 1;
+	const crypto = require('crypto') as typeof import('crypto');
+	const seed = (tag: string) => `sodium,${crypto.createHash('sha256').update(`${base}:${pair}:${tag}`).digest('hex')}`;
+	const group = process.env.PORYGON_DUPLICATE_GROUP;
+	const anchor = group ? Math.max(0, names.findIndex(name => new RegExp(group).test(name))) : 0;
+	const teams = [seed('A'), seed('B')];
+	const playerSeeds = names.map((_, i) => teams[(i === anchor ? 0 : 1) ^ second]);
+	return { pair, second, battleSeed: seed('battle') as PRNGSeed, playerSeeds };
+}
