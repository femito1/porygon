+// Porygon patch: the tunable evaluation. weights None = the stock evaluation; scale / root_weight: the leaf value
+// transform sigmoid(scale * (eval(leaf) - root_weight * eval(root))). Process-wide.
+#[pyfunction]
+#[pyo3(signature = (weights=None, scale=0.0125, root_weight=1.0))]
+fn set_eval(weights: Option<Vec<f32>>, scale: f32, root_weight: f32) -> PyResult<()> {
+    if let Some(w) = &weights {
+        if w.len() != N_EVAL_FEATURES {
+            return Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(format!(
+                "expected {} weights, got {}",
+                N_EVAL_FEATURES,
+                w.len()
+            )));
+        }
+    }
+    set_eval_weights(weights.as_deref());
+    set_leaf_transform(scale, root_weight);
+    Ok(())
+}
+
+#[pyfunction]
+fn evaluate(py_state: PyState) -> f32 {
+    let state: State = py_state.into();
+    engine_evaluate(&state)
+}
+
+#[pyfunction]
+fn eval_features(py_state: PyState) -> Vec<f32> {
+    let state: State = py_state.into();
+    let mut f = [0.0f32; N_EVAL_FEATURES];
+    engine_eval_features(&state, &mut f);
+    f.to_vec()
+}
+
+#[pyfunction]
+fn eval_feature_names() -> Vec<String> {
+    EVAL_FEATURE_NAMES.iter().map(|s| s.to_string()).collect()
+}
+
+/// the state's eval features for many state strings at once (data generation)
+#[pyfunction]
+fn eval_features_many(states: Vec<String>) -> Vec<Vec<f32>> {
+    states
+        .iter()
+        .map(|s| {
+            let state = State::deserialize(s);
+            let mut f = [0.0f32; N_EVAL_FEATURES];
+            engine_eval_features(&state, &mut f);
+            f.to_vec()
+        })
+        .collect()
+}
