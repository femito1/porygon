+#[test]
+#[cfg(feature = "gen4")]
+fn test_gen4_confusion_can_end_before_the_self_hit_check() {
+    let mut state = State::default();
+    state.side_one.volatile_status_durations.confusion = 1;
+    state
+        .side_one
+        .volatile_statuses
+        .insert(PokemonVolatileStatus::CONFUSION);
+
+    let vec_of_instructions = set_moves_on_pkmn_and_call_generate_instructions(
+        &mut state,
+        Choices::SPLASH,
+        Choices::SPLASH,
+    );
+
+    // 2nd attempt: confusion ends with chance 1/4; otherwise it is still a 50% self-hit
+    let mut percentages: Vec<f32> = vec_of_instructions.iter().map(|i| i.percentage).collect();
+    percentages.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    assert_eq!(vec![25.0, 37.5, 37.5], percentages);
+    let ended: Vec<&StateInstructions> = vec_of_instructions
+        .iter()
+        .filter(|i| {
+            i.instruction_list
+                .contains(&Instruction::RemoveVolatileStatus(
+                    RemoveVolatileStatusInstruction {
+                        side_ref: SideReference::SideOne,
+                        volatile_status: PokemonVolatileStatus::CONFUSION,
+                    },
+                ))
+        })
+        .collect();
+    assert_eq!(1, ended.len());
+    assert_eq!(25.0, ended[0].percentage);
+}
