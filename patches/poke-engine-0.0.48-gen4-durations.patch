+// Gen 4 taunt, encore and confusion last a random number of turns (taunt 3-5 turns, encore 4-8 turns,
+// confusion ends on the 2nd-5th move attempt after it starts). The attacker's elapsed count is kept in
+// `volatile_status_durations`; before each move every such effect either ends, with the chance that the
+// duration is exactly this turn given it has lasted this long, or continues with its count incremented.
+#[cfg(feature = "gen4")]
+fn gen4_duration_end_chance(n: i8, lo: i8, hi: i8) -> f32 {
+    // P(D = n | D >= n) for D uniform on lo..=hi
+    if n < lo {
+        0.0
+    } else if n >= hi {
+        1.0
+    } else {
+        1.0 / (hi - n + 1) as f32
+    }
+}
+
+#[cfg(feature = "gen4")]
+fn gen4_duration_branches(
+    state: &mut State,
+    attacking_side: &SideReference,
+    incoming_instructions: &StateInstructions,
+) -> Vec<StateInstructions> {
+    state.apply_instructions(&incoming_instructions.instruction_list);
+    let side = state.get_side_immutable(attacking_side);
+    let durations = &side.volatile_status_durations;
+    let mut timed: Vec<(PokemonVolatileStatus, i8, f32)> = vec![];
+    for (vs, elapsed, lo, hi) in [
+        (PokemonVolatileStatus::TAUNT, durations.taunt, 3, 5),
+        (PokemonVolatileStatus::ENCORE, durations.encore, 4, 8),
+        (PokemonVolatileStatus::CONFUSION, durations.confusion, 2, 5),
+    ] {
+        if side.volatile_statuses.contains(&vs) {
+            timed.push((vs, elapsed, gen4_duration_end_chance(elapsed + 1, lo, hi)));
+        }
+    }
+    state.reverse_instructions(&incoming_instructions.instruction_list);
+
+    let mut branches = vec![];
+    for mask in 0..(1u8 << timed.len()) {
+        let mut branch = incoming_instructions.clone();
+        for (i, (vs, elapsed, end_chance)) in timed.iter().enumerate() {
+            let ends = mask & (1 << i) != 0;
+            branch.update_percentage(if ends { *end_chance } else { 1.0 - *end_chance });
+            branch
+                .instruction_list
+                .push(Instruction::ChangeVolatileStatusDuration(
+                    ChangeVolatileStatusDurationInstruction {
+                        side_ref: *attacking_side,
+                        volatile_status: *vs,
+                        amount: if ends { -*elapsed } else { 1 },
+                    },
+                ));
+            if ends {
+                branch
+                    .instruction_list
+                    .push(Instruction::RemoveVolatileStatus(
+                        RemoveVolatileStatusInstruction {
+                            side_ref: *attacking_side,
+                            volatile_status: *vs,
+                        },
+                    ));
+            }
+        }
+        if branch.percentage > 0.0 {
+            branches.push(branch);
+        }
+    }
+    branches
+}
+
 pub fn generate_instructions_from_move(
+    state: &mut State,
+    choice: &mut Choice,
+    defender_choice: &Choice,
+    attacking_side: SideReference,
+    incoming_instructions: StateInstructions,
+    final_instructions: &mut Vec<StateInstructions>,
+    branch_on_damage: bool,
+) {
+    #[cfg(feature = "gen4")]
+    if choice.category != MoveCategory::Switch && choice.move_id != Choices::NONE {
+        let mut branches = gen4_duration_branches(state, &attacking_side, &incoming_instructions);
+        if let Some(last) = branches.pop() {
+            for branch in branches {
+                generate_move_instructions(
+                    state,
+                    &mut choice.clone(),
+                    defender_choice,
+                    attacking_side,
+                    branch,
+                    final_instructions,
+                    branch_on_damage,
+                );
+            }
+            // the caller may read the choice afterwards: the last branch uses it
+            generate_move_instructions(
+                state,
+                choice,
+                defender_choice,
+                attacking_side,
+                last,
+                final_instructions,
+                branch_on_damage,
+            );
+            return;
+        }
+    }
+    generate_move_instructions(
+        state,
+        choice,
+        defender_choice,
+        attacking_side,
+        incoming_instructions,
+        final_instructions,
+        branch_on_damage,
+    );
+}
