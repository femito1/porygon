+#[test]
+#[cfg(feature = "gen4")]
+fn test_gen4_switching_out_resets_the_confusion_count() {
+    let mut state = State::default();
+    state.side_one.volatile_status_durations.confusion = 2;
+    state
+        .side_one
+        .volatile_statuses
+        .insert(PokemonVolatileStatus::CONFUSION);
+
+    let side_one_move = MoveChoice::Switch(PokemonIndex::P1);
+    let side_two_move = MoveChoice::None;
+    let vec_of_instructions =
+        generate_instructions_with_state_assertion(&mut state, &side_one_move, &side_two_move);
+
+    assert_eq!(1, vec_of_instructions.len());
+    let list = &vec_of_instructions[0].instruction_list;
+    assert!(list.contains(&Instruction::ChangeVolatileStatusDuration(
+        ChangeVolatileStatusDurationInstruction {
+            side_ref: SideReference::SideOne,
+            volatile_status: PokemonVolatileStatus::CONFUSION,
+            amount: -2,
+        }
+    )));
+    assert!(list.contains(&Instruction::RemoveVolatileStatus(
+        RemoveVolatileStatusInstruction {
+            side_ref: SideReference::SideOne,
+            volatile_status: PokemonVolatileStatus::CONFUSION,
+        }
+    )));
+}
